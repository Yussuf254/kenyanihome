<%- include('../../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
:root {
  --green: #0B6B3A;
  --green-dark: #084d29;
  --green-light: #e8f5e9;
  --text: #111827;
  --text-muted: #6b7280;
  --border: #e5e7eb;
  --white: #ffffff;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Montserrat', sans-serif; background: #f8f9fa; color: var(--text); line-height: 1.6; }
a { text-decoration: none; color: inherit; }

.dash-layout { display: flex; min-height: 100vh; }
.dash-sidebar { width: 260px; background: #0C1210; color: #fff; padding: 24px 0; flex-shrink: 0; }
.dash-sidebar .brand { padding: 0 24px 24px; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 16px; }
.dash-sidebar .brand h2 { font-size: 18px; font-weight: 700; color: #fff; margin: 0; }
.dash-sidebar .brand h2 span { color: #4ade80; }
.dash-sidebar .brand small { font-size: 11px; color: #999; }
.dash-sidebar .nav a { display: flex; align-items: center; gap: 10px; padding: 12px 24px; color: rgba(255,255,255,.7); font-size: 14px; transition: all .2s; }
.dash-sidebar .nav a:hover, .dash-sidebar .nav a.active { background: rgba(255,255,255,.1); color: #fff; }
.dash-main { flex: 1; background: #f8f9fa; padding: 32px; }
.dash-header { margin-bottom: 24px; }
.dash-header h1 { font-size: 22px; font-weight: 700; margin: 0; }
.card { background: #fff; border-radius: 12px; border: 1px solid var(--border); padding: 32px; }
.form-group { margin-bottom: 20px; }
.form-group label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13px; }
.form-group input, .form-group select, .form-group textarea { width: 100%; padding: 12px 16px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; font-family: 'Montserrat', sans-serif; }
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--green); }
.form-group textarea { min-height: 120px; resize: vertical; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: var(--green); color: #fff; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; font-family: 'Montserrat', sans-serif; }
.btn:hover { background: var(--green-dark); }
.note { font-size: 12px; color: var(--text-muted); }

@media (max-width: 768px) {
  .dash-layout { flex-direction: column; }
  .dash-sidebar { width: 100%; padding: 16px 0; }
  .dash-sidebar .nav { display: flex; overflow-x: auto; padding: 0 16px; }
  .dash-sidebar .nav a { white-space: nowrap; padding: 10px 16px; }
  .dash-main { padding: 20px; }
  .form-row { grid-template-columns: 1fr; }
}
</style>

<div class="dash-layout">
  <aside class="dash-sidebar">
    <div class="brand">
      <h2>Kenya ni Home <span>Jobs</span></h2>
      <small>Employer Dashboard</small>
    </div>
    <nav class="nav">
      <a href="/employer/dashboard"><i class="fas fa-home"></i> Dashboard</a>
      <a href="/employer/jobs/create" class="active"><i class="fas fa-plus"></i> Post a Job</a>
      <a href="/employer/jobs"><i class="fas fa-briefcase"></i> My Jobs</a>
      <a href="/employer/profile"><i class="fas fa-building"></i> Company Profile</a>
      <a href="/jobs" target="_blank"><i class="fas fa-external-link-alt"></i> View Site</a>
      <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </nav>
  </aside>

  <main class="dash-main">
    <div class="dash-header">
      <h1>Post a New Job</h1>
    </div>

    <div class="card">
      <form action="/employer/jobs/create" method="POST">
        <div class="form-group">
          <label>Job Title *</label>
          <input type="text" name="title" required placeholder="e.g. Senior Software Engineer">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Category *</label>
            <select name="categoryId" required>
              <option value="">Select Category</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>Employment Type *</label>
            <select name="employmentType" required>
              <option value="Full Time">Full Time</option>
              <option value="Part Time">Part Time</option>
              <option value="Contract">Contract</option>
              <option value="Internship">Internship</option>
              <option value="Volunteer">Volunteer</option>
              <option value="Remote">Remote</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Location *</label>
            <input type="text" name="location" required placeholder="e.g. Nairobi, Kenya">
          </div>
          <div class="form-group">
            <label>Salary (optional)</label>
            <input type="text" name="salary" placeholder="e.g. KSh 100,000 – 150,000">
          </div>
        </div>

        <div class="form-group">
          <label>Application Deadline *</label>
          <input type="date" name="deadline" required>
        </div>

        <div class="form-group">
          <label>Job Description *</label>
          <textarea name="description" required placeholder="Describe the role, responsibilities, and ideal candidate"></textarea>
        </div>

        <div class="form-group">
          <label>Requirements (one per line)</label>
          <textarea name="requirements" placeholder="Bachelor's degree in relevant field&#10;3+ years experience&#10;Strong communication skills"></textarea>
        </div>

        <div class="form-group">
          <label>Responsibilities (one per line)</label>
          <textarea name="responsibilities" placeholder="Develop and maintain web applications&#10;Collaborate with cross-functional teams&#10;Write clean, documented code"></textarea>
        </div>

        <button type="submit" class="btn"><i class="fas fa-paper-plane"></i> Submit Job for Review</button>
        <p class="note" style="margin-top:12px;">Your job will be reviewed by our team before publishing.</p>
      </form>
    </div>
  </main>
</div>

<%- include('../../partials/foot') %>
