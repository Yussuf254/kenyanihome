<%- include('../../partials/head') %>

<style>
  .dash-layout { display: flex; min-height: 100vh; }
  .dash-sidebar { width: 260px; background: #0C1210; color: #fff; padding: 24px 0; flex-shrink: 0; }
  .dash-sidebar .brand { padding: 0 24px 24px; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 16px; }
  .dash-sidebar .brand h2 { font-family: 'Roboto Slab', serif; font-size: 18px; color: #fff; margin: 0; }
  .dash-sidebar .brand span { font-size: 11px; color: #999; }
  .dash-sidebar .nav a { display: block; padding: 12px 24px; color: rgba(255,255,255,.7); text-decoration: none; font-size: 14px; }
  .dash-sidebar .nav a:hover, .dash-sidebar .nav a.active { background: rgba(255,255,255,.1); color: #fff; }
  .dash-main { flex: 1; background: #f8f7f4; padding: 32px; }
  .dash-header { margin-bottom: 24px; }
  .dash-header h1 { font-family: 'Roboto Slab', serif; font-size: 24px; margin: 0; }
  .card { background: #fff; border-radius: 12px; border: 1px solid #e8e5e0; overflow: hidden; }
  .table { width: 100%; border-collapse: collapse; }
  .table th, .table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }
  .table th { background: #f8f7f4; font-weight: 600; }
  .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
  .badge-paid { background: #e6f4ea; color: #1a4d2e; }
  .badge-pending { background: #fff3e0; color: #e65100; }
  .badge-failed { background: #ffebee; color: #c62828; }
  .packages { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px; }
  .package { background: #fff; border: 2px solid #e8e5e0; border-radius: 12px; padding: 24px; text-align: center; }
  .package.featured { border-color: #1a4d2e; }
  .package h3 { font-family: 'Roboto Slab', serif; margin: 0 0 8px; }
  .package .price { font-size: 32px; font-weight: 700; color: #1a4d2e; margin: 16px 0; }
  .package .price span { font-size: 14px; color: #666; font-weight: 400; }
  .package ul { list-style: none; padding: 0; margin: 0 0 20px; text-align: left; }
  .package ul li { padding: 6px 0; font-size: 13px; color: #666; }
  .package ul li::before { content: '✓ '; color: #1a4d2e; font-weight: 700; }
</style>

<div class="dash-layout">
  <aside class="dash-sidebar">
    <div class="brand">
      <h2>Jobs Portal</h2>
      <span>Employer Dashboard</span>
    </div>
    <nav class="nav">
      <a href="/employer/dashboard">Dashboard</a>
      <a href="/employer/jobs/create">Post a Job</a>
      <a href="/employer/jobs">My Jobs</a>
      <a href="/employer/profile">Company Profile</a>
      <a href="/employer/payments" class="active">Payments</a>
      <a href="/jobs">View Site</a>
      <a href="/logout">Logout</a>
    </nav>
  </aside>

  <main class="dash-main">
    <div class="dash-header">
      <h1>Payment History</h1>
    </div>

    <div class="card" style="margin-bottom: 32px;">
      <h3 style="margin-bottom: 16px;">Your Payments</h3>
      <% if (payments.length === 0) { %>
        <p style="color: #666;">No payment history yet.</p>
      <% } else { %>
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Package</th>
              <th>Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% payments.forEach(function(p) { %>
              <tr>
                <td><%= formatDate(p.createdAt) %></td>
                <td><%= p.packageName || 'Standard' %></td>
                <td>KSh <%= (p.amount || 0).toLocaleString() %></td>
                <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>

<%- include('../../partials/foot') %>
