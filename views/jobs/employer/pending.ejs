<%- include('../../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
:root {
  --green: #0B6B3A;
  --green-dark: #084d29;
  --green-light: #e8f5e9;
  --text: #111827;
  --text-muted: #6b7280;
  --border: #e5e7eb;
  --white: #ffffff;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Montserrat', sans-serif; background: #f8f9fa; color: var(--text); line-height: 1.6; }
a { text-decoration: none; color: inherit; }

.pending-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; }
.pending-box { width: 100%; max-width: 520px; background: var(--white); padding: 48px; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,.08); text-align: center; }
.pending-icon { width: 80px; height: 80px; margin: 0 auto 24px; background: var(--green-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36px; color: var(--green); }
.pending-box .logo { font-size: 24px; font-weight: 800; color: var(--green); margin-bottom: 16px; }
.pending-box .logo span { color: var(--text); }
.pending-box h1 { font-size: 22px; font-weight: 700; margin-bottom: 12px; }
.pending-box p { color: var(--text-muted); margin-bottom: 16px; font-size: 14px; line-height: 1.7; }
.pending-box .info-box { background: var(--green-light); border-radius: 8px; padding: 16px; margin-bottom: 24px; text-align: left; }
.pending-box .info-box h4 { font-size: 13px; font-weight: 600; color: var(--green); margin-bottom: 8px; text-transform: uppercase; letter-spacing: .5px; }
.pending-box .info-box ul { list-style: none; padding: 0; }
.pending-box .info-box li { font-size: 13px; color: var(--text); padding: 4px 0; display: flex; align-items: center; gap: 8px; }
.pending-box .info-box li i { color: var(--green); font-size: 12px; }
.pending-box .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: var(--green); color: var(--white); border-radius: 8px; font-weight: 600; font-size: 14px; }
.pending-box .btn:hover { background: var(--green-dark); }
.pending-box .contact { margin-top: 20px; font-size: 13px; color: var(--text-muted); }
.pending-box .contact a { color: var(--green); font-weight: 600; }

@media (max-width: 480px) {
  .pending-box { padding: 32px 24px; }
}
</style>

<div class="pending-page">
  <div class="pending-box">
    <div class="logo">Kenya ni Home <span>Jobs</span></div>
    <div class="pending-icon"><i class="fas fa-clock"></i></div>
    <h1>Account Pending Verification</h1>
    <p>Your employer account has been submitted and is currently under review. Our team will verify your details and grant access within 24-48 hours.</p>
    
    <div class="info-box">
      <h4>What happens next?</h4>
      <ul>
        <li><i class="fas fa-check-circle"></i> Our team reviews your company details</li>
        <li><i class="fas fa-check-circle"></i> You'll receive an email once verified</li>
        <li><i class="fas fa-check-circle"></i> You can then post jobs and manage applications</li>
      </ul>
    </div>
    
    <a href="/employer/login" class="btn"><i class="fas fa-arrow-left"></i> Back to Login</a>
    
    <p class="contact">Questions? Contact us at <a href="mailto:support@kenyanihome.com">support@kenyanihome.com</a></p>
  </div>
</div>

<%- include('../../partials/foot') %>
