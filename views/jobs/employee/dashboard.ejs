<%- include('../../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
:root {
  --green: #0B6B3A;
  --green-dark: #084d29;
  --green-light: #e8f5e9;
  --text: #111827;
  --text-secondary: #4b5563;
  --text-muted: #6b7280;
  --border: #e5e7eb;
  --bg: #f8f9fa;
  --white: #ffffff;
  --radius: 12px;
  --shadow: 0 1px 3px rgba(0,0,0,.08);
  --shadow-lg: 0 4px 16px rgba(0,0,0,.1);
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Montserrat', sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
a { text-decoration: none; color: inherit; }

.portal-layout { display: flex; min-height: 100vh; }
.portal-sidebar { width: 260px; background: #0C1210; color: #fff; padding: 24px 0; flex-shrink: 0; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
.portal-sidebar .brand { padding: 0 24px 24px; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 16px; }
.portal-sidebar .brand h2 { font-size: 18px; font-weight: 700; color: #fff; margin: 0; }
.portal-sidebar .brand h2 span { color: #4ade80; }
.portal-sidebar .brand small { font-size: 11px; color: #999; }
.portal-sidebar .nav { display: flex; flex-direction: column; gap: 2px; }
.portal-sidebar .nav a { display: flex; align-items: center; gap: 10px; padding: 12px 24px; color: rgba(255,255,255,.7); font-size: 14px; transition: all .2s; border-left: 3px solid transparent; }
.portal-sidebar .nav a:hover, .portal-sidebar .nav a.active { background: rgba(255,255,255,.1); color: #fff; border-left-color: #4ade80; }
.portal-main { flex: 1; background: #f8f9fa; }
.portal-header { background: #fff; border-bottom: 1px solid var(--border); padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
.portal-header h1 { font-size: 20px; font-weight: 700; margin: 0; }
.portal-content { padding: 32px; max-width: 1200px; }

.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 32px; }
.stat-card { background: #fff; padding: 24px; border-radius: var(--radius); border: 1px solid var(--border); }
.stat-card .stat-value { font-size: 32px; font-weight: 700; color: var(--green); margin-bottom: 4px; }
.stat-card .stat-label { font-size: 13px; color: var(--text-muted); }

.card { background: #fff; border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; margin-bottom: 24px; }
.card-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
.card-header h3 { font-size: 16px; font-weight: 600; margin: 0; }
.card-body { padding: 24px; }

.btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: var(--green); color: #fff; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; font-family: 'Montserrat', sans-serif; transition: all .2s; }
.btn:hover { background: var(--green-dark); }
.btn-outline { background: transparent; border: 1px solid var(--green); color: var(--green); }
.btn-outline:hover { background: var(--green-light); }
.btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text); }
.btn-ghost:hover { background: var(--bg); }
.btn-sm { padding: 6px 14px; font-size: 13px; }
.btn-danger { background: #dc2626; }
.btn-danger:hover { background: #b91c1c; }

.table { width: 100%; border-collapse: collapse; }
.table th, .table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--border); }
.table th { background: #f9fafb; font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
.table td { font-size: 14px; }

.badge { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 20px; }
.badge-published { background: #d1fae5; color: #059669; }
.badge-pending { background: #fef3c7; color: #d97706; }
.badge-rejected { background: #fee2e2; color: #dc2626; }
.badge-shortlisted { background: #dbeafe; color: #2563eb; }
.badge-submitted { background: #f3e8ff; color: #7c3aed; }

@media (max-width: 768px) {
  .portal-layout { flex-direction: column; }
  .portal-sidebar { width: 100%; height: auto; position: static; }
  .portal-sidebar .nav { flex-direction: row; overflow-x: auto; padding: 0 16px; }
  .portal-sidebar .nav a { white-space: nowrap; padding: 10px 16px; }
  .portal-content { padding: 20px; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>

<div class="portal-layout">
  <aside class="portal-sidebar">
    <div class="brand">
      <h2>Kenya ni Home <span>Jobs</span></h2>
      <small>Job Seeker Portal</small>
    </div>
    <nav class="nav">
      <a href="/jobs/dashboard" class="<%= currentPath === '/jobs/dashboard' ? 'active' : '' %>"><i class="fas fa-home"></i> Dashboard</a>
      <a href="/jobs/profile" class="<%= currentPath === '/jobs/profile' ? 'active' : '' %>"><i class="fas fa-user"></i> My Profile</a>
      <a href="/jobs/applications" class="<%= currentPath === '/jobs/applications' ? 'active' : '' %>"><i class="fas fa-file-alt"></i> My Applications</a>
      <a href="/jobs/saved" class="<%= currentPath === '/jobs/saved' ? 'active' : '' %>"><i class="fas fa-bookmark"></i> Saved Jobs</a>
      <a href="/jobs"><i class="fas fa-search"></i> Browse Jobs</a>
      <a href="/jobs/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </nav>
  </aside>

  <main class="portal-main">
    <header class="portal-header">
      <h1>Welcome back, <%= user.username %>!</h1>
      <a href="/jobs" class="btn btn-sm">Browse Jobs</a>
    </header>

    <div class="portal-content">
      <!-- Stats -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-value"><%= stats.totalApplications %></div>
          <div class="stat-label">Total Applications</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.pending %></div>
          <div class="stat-label">Pending Review</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.shortlisted %></div>
          <div class="stat-label">Shortlisted</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.savedJobs %></div>
          <div class="stat-label">Saved Jobs</div>
        </div>
      </div>

      <!-- Recent Applications -->
      <div class="card">
        <div class="card-header">
          <h3>Recent Applications</h3>
          <a href="/jobs/applications" class="btn btn-ghost btn-sm">View All</a>
        </div>
        <div class="card-body" style="padding:0;">
          <% if (applications.length === 0) { %>
            <div style="padding:40px;text-align:center;color:var(--text-muted);">
              <div style="margin-bottom:12px;">No applications yet</div>
              <a href="/jobs" class="btn btn-sm">Browse Jobs & Apply</a>
            </div>
          <% } else { %>
            <table class="table">
              <thead>
                <tr>
                  <th>Job Title</th>
                  <th>Company</th>
                  <th>Status</th>
                  <th>Applied</th>
                </tr>
              </thead>
              <tbody>
                <% applications.slice(0, 5).forEach(function(app) { %>
                  <tr>
                    <td><strong><%= app.jobTitle %></strong></td>
                    <td><%= app.company %></td>
                    <td><span class="badge badge-<%= app.status %>"><%= app.status.replace('_', ' ') %></span></td>
                    <td style="color:var(--text-muted);"><%= formatDate(app.createdAt) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>

      <!-- Profile Completion -->
      <div class="card">
        <div class="card-header">
          <h3>Profile Completion</h3>
          <a href="/jobs/profile" class="btn btn-ghost btn-sm">Edit Profile</a>
        </div>
        <div class="card-body">
          <% 
            let completed = 0;
            if (user.bio) completed++;
            if (user.skills) completed++;
            if (user.cvUrl) completed++;
            if (user.education) completed++;
            if (user.experience) completed++;
            if (user.photoUrl) completed++;
            let percentage = Math.round((completed / 6) * 100);
          %>
          <div style="margin-bottom:16px;">
            <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
              <span style="font-size:14px;font-weight:500;"><%= percentage %> Complete</span>
              <span style="font-size:13px;color:var(--text-muted);"><%= completed %> of 6 sections</span>
            </div>
            <div style="height:8px;background:#f3f4f6;border-radius:4px;overflow:hidden;">
              <div style="height:100%;width:<%= percentage %>%;background:var(--green);border-radius:4px;"></div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;">
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
              <i class="fas fa-<%= user.bio ? 'check-circle' : 'circle' %>" style="color:<%= user.bio ? 'var(--green)' : 'var(--text-muted)' %>;"></i> Bio
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
              <i class="fas fa-<%= user.skills ? 'check-circle' : 'circle' %>" style="color:<%= user.skills ? 'var(--green)' : 'var(--text-muted)' %>;"></i> Skills
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
              <i class="fas fa-<%= user.cvUrl ? 'check-circle' : 'circle' %>" style="color:<%= user.cvUrl ? 'var(--green)' : 'var(--text-muted)' %>;"></i> CV Uploaded
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
              <i class="fas fa-<%= user.education ? 'check-circle' : 'circle' %>" style="color:<%= user.education ? 'var(--green)' : 'var(--text-muted)' %>;"></i> Education
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
              <i class="fas fa-<%= user.experience ? 'check-circle' : 'circle' %>" style="color:<%= user.experience ? 'var(--green)' : 'var(--text-muted)' %>;"></i> Experience
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
              <i class="fas fa-<%= user.photoUrl ? 'check-circle' : 'circle' %>" style="color:<%= user.photoUrl ? 'var(--green)' : 'var(--text-muted)' %>;"></i> Photo
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../../partials/foot') %>
