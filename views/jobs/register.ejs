<%- include('../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
:root {
  --green: #0B6B3A;
  --green-dark: #084d29;
  --green-light: #e8f5e9;
  --text: #111827;
  --text-muted: #6b7280;
  --border: #e5e7eb;
  --white: #ffffff;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Montserrat', sans-serif; background: #f8f9fa; color: var(--text); line-height: 1.6; }
a { text-decoration: none; color: inherit; }

.auth-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; }
.auth-box { width: 100%; max-width: 480px; background: var(--white); padding: 40px; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,.08); }
.auth-box .logo { text-align: center; font-size: 24px; font-weight: 800; color: var(--green); margin-bottom: 24px; }
.auth-box .logo span { color: var(--text); }
.auth-box h1 { font-size: 22px; font-weight: 700; margin-bottom: 6px; text-align: center; }
.auth-box .subtitle { text-align: center; color: var(--text-muted); margin-bottom: 28px; font-size: 14px; }
.auth-box .form-group { margin-bottom: 18px; }
.auth-box label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13px; }
.auth-box input, .auth-box select { width: 100%; padding: 12px 16px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; font-family: 'Montserrat', sans-serif; }
.auth-box input:focus, .auth-box select:focus { outline: none; border-color: var(--green); }
.auth-box .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.auth-box button { width: 100%; padding: 14px; background: var(--green); color: var(--white); border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 8px; font-family: 'Montserrat', sans-serif; }
.auth-box button:hover { background: var(--green-dark); }
.auth-box .link { text-align: center; margin-top: 20px; font-size: 14px; color: var(--text-muted); }
.auth-box .link a { color: var(--green); font-weight: 600; }
.auth-box .back { display: flex; align-items: center; gap: 6px; margin-bottom: 20px; color: var(--text-muted); font-size: 13px; }

@media (max-width: 480px) {
  .auth-box { padding: 24px; }
  .auth-box .form-row { grid-template-columns: 1fr; }
}
</style>

<div class="auth-page">
  <div class="auth-box">
    <a href="/jobs" class="back"><i class="fas fa-arrow-left"></i> Back to Jobs</a>
    <div class="logo">Kenya ni Home <span>Jobs</span></div>
    <h1>Create Job Seeker Account</h1>
    <p class="subtitle">Register to apply for jobs</p>

    <form action="/jobs/register" method="POST">
      <div class="form-group">
        <label>Full Name *</label>
        <input type="text" name="name" required placeholder="Your full name">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Email *</label>
          <input type="email" name="email" required placeholder="your@email.com">
        </div>
        <div class="form-group">
          <label>Phone *</label>
          <input type="tel" name="phone" required placeholder="+254 700 000 000">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>County</label>
          <input type="text" name="county" placeholder="e.g. Nairobi">
        </div>
        <div class="form-group">
          <label>Professional Category</label>
          <input type="text" name="category" placeholder="e.g. ICT, Finance">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Password *</label>
          <input type="password" name="password" required minlength="8" placeholder="Min 8 characters">
        </div>
        <div class="form-group">
          <label>Confirm Password *</label>
          <input type="password" name="passwordConfirm" required minlength="8" placeholder="Confirm password">
        </div>
      </div>
      <button type="submit">Create Account</button>
    </form>

    <p class="link">Already have an account? <a href="/jobs/login">Sign in</a></p>
  </div>
</div>

<%- include('../partials/foot') %>
