  }
  .trending-item:last-child { border-bottom: none; }
  .trending-item:hover { background: rgba(15, 107, 52, .03); }
  .trending-number {
    font: 900 24px/1 'Montserrat', sans-serif;
    color: var(--red);
    min-width: 36px;
    text-align: right;
    flex-shrink: 0;
    letter-spacing: -0.03em;
    margin-top: 1px;
  }
  .trending-content { flex: 1; min-width: 0; }
  .trending-title {
    font: 700 14px/1.45 'Montserrat', sans-serif;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition);
    margin-bottom: 5px;
  }
  .trending-item:hover .trending-title { color: var(--green); }
  .trending-meta {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .trending-meta .cat {
    color: var(--green);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 9px;
    letter-spacing: 0.6px;
    background: rgba(15, 107, 52, .08);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .trending-meta .views {
    color: #9ca3af;
    font-size: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .new-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: #fef2f2;
    color: var(--red);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* ===== Latest News — Magazine List ===== */
  .story-list { display: flex; flex-direction: column; gap: 0; }
  .story-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition);
    position: relative;
  }
  .story-item:last-child { border-bottom: none; }
  .story-item:hover { background: rgba(15, 107, 52, .03); }
  .story-thumb {
    flex-shrink: 0;
    width: 110px;
    height: 82px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #e5e7eb;
    border: 1px solid rgba(0,0,0,.05);
  }
  .story-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }
  .story-item:hover .story-thumb img { transform: scale(1.05); }
  .story-content { flex: 1; min-width: 0; }
  .story-content .badge { height: 26px; font-size: 10px; padding: 0 10px; margin-bottom: 6px; }
  .story-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.4;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition);
    margin-bottom: 5px;
  }
  .story-item:hover .story-title { color: var(--green); }
  .story-meta {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .story-meta .read-time {
    color: #9ca3af;
    font-size: 10px;
  }
  .story-meta .new-pill {
    background: #fef2f2;
    color: var(--red);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* ===== Article Cards — Premium Edge-to-Edge Images ===== */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }
  @media (min-width: 640px) { .cards-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cards-grid { grid-template-columns: repeat(4, 1fr); } }

  .card {
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: box-shadow var(--transition), transform var(--transition);
    min-width: 0;
  }
  .card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .card-image {
    position: relative;
