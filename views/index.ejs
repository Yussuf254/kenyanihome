  .trending-number {
    font: 900 22px/1 'Montserrat', sans-serif;
    color: var(--red);
    min-width: 32px;
    text-align: right;
    flex-shrink: 0;
    letter-spacing: -0.02em;
  }
  .trending-content { flex: 1; min-width: 0; }
  .trending-title {
    font: 700 13px/1.4 'Montserrat', sans-serif;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
