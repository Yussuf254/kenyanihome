    background: #8B1A1A;
    border-color: #8B1A1A;
  }

  /* ===== Trending Now — Premium List ===== */
  .trending-list { display: flex; flex-direction: column; gap: 0; }
  .trending-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition);
