          </div>
          <div class="headline-card-body">
            <span class="badge"><%= (p.category || 'News').toUpperCase() %></span>
            <h4 class="headline-card-title"><a href="/post/<%= p.slug %>"><%= p.title %></a></h4>
            <div class="card-meta">
              <span class="author"><%= (p.author || 'Newsroom') %></span>
              <span>·</span>
              <span><%= formatDate(p.createdAt) %></span>
