<script>
  (function () {
    var nf = document.getElementById('newsletter-form-home');
    if (!nf) return;
    var msg = document.getElementById('newsletter-msg-home');
    nf.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = nf.querySelector('button');
      var email = nf.querySelector('input[name="email"]').value;
      btn.disabled = true;
      try {
        var res = await fetch('/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
          body: 'email=' + encodeURIComponent(email)
        });
        var data = await res.json();
        if (msg) { msg.style.display = 'block'; msg.textContent = data.message; }
        if (data.ok) {
          btn.textContent = 'Subscribed ✓';
          nf.querySelector('input').value = '';
        } else {
          btn.disabled = false;
        }
      } catch (err) {
        if (msg) { msg.style.display = 'block'; msg.textContent = 'Something went wrong — try again.'; }
        btn.disabled = false;
      }
    });
  })();
</script>

<%- include('partials/foot') %>
