    .newsletter-box { padding: 16px; }
    .newsletter-form {
      flex-direction: column;
      border-radius: var(--radius);
      background: transparent;
      gap: 10px;
    }
    .newsletter-form input {
      background: rgba(255,255,255,.15);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      width: 100%;
    }
    .newsletter-form button {
      padding: 12px;
      border-radius: var(--radius-sm);
      width: 100%;
    }
  }

  /* ===== Category Grid — Magazine Style ===== */
  .cat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 24px;
  }
  @media (min-width: 768px) {
    .cat-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
  }

  .cat-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: #1a1a1a;
    aspect-ratio: 3 / 4;
  }
  @media (min-width: 768px) {
    .cat-card {
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }
    .cat-card:first-child { border-radius: var(--radius) 0 0 var(--radius); }
    .cat-card:last-child { border-radius: 0 var(--radius) var(--radius) 0; }
  }
  .cat-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-4px);
    z-index: 2;
  }
  .cat-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .cat-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .cat-card:hover .cat-card-image img { transform: scale(1.08); }
  .cat-card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.25) 50%, rgba(0,0,0,.1) 100%);
  }
  .cat-card-body {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 20px;
    z-index: 2;
    background: linear-gradient(to top, rgba(0,0,0,.55) 0%, rgba(0,0,0,.15) 60%, transparent 100%);
  }
  .cat-card-body .badge {
    height: 24px;
    font-size: 9px;
    padding: 0 8px;
    margin-bottom: 10px;
    background: var(--red);
  }
  .cat-card-body .badge:hover { background: var(--red-dark); }
  .cat-card-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--white);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0,0,0,.4);
    margin-bottom: 6px;
  }
  .cat-card:hover .cat-card-title { color: #fbbf24; }
  @media (min-width: 768px) {
    .cat-card-title { font-size: 16px; }
  }

  /* ===== Headlines Grid ===== */
  .headlines-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }
  @media (min-width: 640px) { .headlines-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .headlines-grid { grid-template-columns: repeat(4, 1fr); } }

  .headline-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: box-shadow var(--transition), transform var(--transition);
    min-width: 0;
  }
  .headline-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .headline-card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .headline-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .headline-card:hover .headline-card-image img { transform: scale(1.05); }
  .headline-card-body { padding: 20px; }
  .headline-card-body .badge { height: 26px; font-size: 10px; padding: 0 10px; margin-bottom: 10px; }
  .headline-card-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition);
    margin-bottom: 8px;
  }
  .headline-card:hover .headline-card-title { color: var(--green); }

  /* ===== No Image Placeholder ===== */
  .no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  }
  .no-image svg { width: 40px; height: 40px; opacity: .6; }

  /* ===== Responsive Tweaks ===== */
  @media (min-width: 768px) {
    .card-body { padding: 28px; }
    .headline-card-body { padding: 28px; }
    .side-feature-body { padding: 28px; }
  }
  @media (max-width: 639px) {
    .hero-content { padding: 16px; }
    .hero-title { font-size: 18px; }
    .hero-excerpt { display: none; }
    .hero-meta { font-size: 11px; }
    .cards-grid { gap: 16px; }
    .story-thumb { width: 90px; height: 68px; }
    .trending-number { font-size: 20px; min-width: 28px; }
    .trending-title { font-size: 13px; }
    .trending-item { gap: 10px; padding: 12px 0; }
    .breaking-content { padding: 16px; }
    .breaking-title { font-size: 16px; }
    .card-title { font-size: 15px; }
    .headline-card-title { font-size: 15px; }
    .side-feature-title { font-size: 15px; }
    .story-title { font-size: 14px; }
    .card-body { padding: 16px; }
    .headline-card-body { padding: 16px; }
    .side-feature-body { padding: 16px; }
  }
</style>

<% const tones = ['', '', '', '']; %>
<% const safePosts = posts || []; %>
<% const safeTrending = trending || []; %>
<% const safeMostRead = mostRead || []; %>
<% const safeFeaturedStories = featuredStories || []; %>
<% const safeBreaking = Array.isArray(breaking) ? breaking : []; %>
<% const quickItems = safeFeaturedStories.length ? safeFeaturedStories : (safeTrending.length ? safeTrending : safePosts).slice(0, 4); %>
<% const wn = (safeFeaturedStories[0] || safeTrending[0] || null); %>

<!-- ===== HERO SECTION ===== -->
<% if (featured) { %>
<section class="hero">
  <div class="container">
    <div class="hero-card">
      <div class="hero-image-wrap">
        <% if (featured.coverImage) { %>
          <img src="<%= featured.coverImage %>" alt="<%= featured.title %>" width="1200" height="675" fetchpriority="high" decoding="async">
        <% } else { %>
          <div class="no-image"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
        <% } %>
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <span class="badge"><%= (featured.category || 'News').toUpperCase() %></span>
        <h2 class="hero-title"><a href="/post/<%= featured.slug %>"><%= featured.title %></a></h2>
        <p class="hero-excerpt"><%= featured.excerpt %></p>
        <div class="hero-meta">
          <span class="author"><%= (featured.author || 'Newsroom') %></span>
          <span class="sep">·</span>
          <span><%= formatDate(featured.createdAt) %></span>
          <span class="sep">·</span>
          <span><%= readingTime(featured.content) %> min read</span>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- ===== BREAKING NEWS ===== -->
<% if (safeBreaking && safeBreaking.length) { %>
<section class="breaking-section">
  <div class="container">
    <% safeBreaking.slice(0, 1).forEach(function(b) { %>
    <div class="breaking-card">
      <div class="breaking-image-wrap">
        <% if (b.coverImage) { %>
          <img src="<%= b.coverImage %>" alt="<%= b.title %>" loading="lazy" width="800" height="450" decoding="async">
        <% } else { %>
          <div class="no-image"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
        <% } %>
        <div class="breaking-overlay"></div>
        <span class="breaking-badge">BREAKING</span>
      </div>
      <div class="breaking-content">
        <h2 class="breaking-title"><a href="/post/<%= b.slug %>"><%= b.title %></a></h2>
        <p class="breaking-excerpt"><%= b.excerpt %></p>
        <div class="breaking-meta">
          <span class="author"><%= (b.author || 'Newsroom') %></span>
          <span class="sep">·</span>
          <span><%= formatDate(b.createdAt) %></span>
          <span class="sep">·</span>
          <span><%= readingTime(b.content) %> min read</span>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- ===== QUICK ROW (4 cards below hero) ===== -->
<% if (quickItems.length) { %>
<section style="margin-bottom: 24px;">
  <div class="container">
    <div class="cards-grid">
      <% quickItems.slice(0, 4).forEach(function(p, i) { %>
      <article class="card">
        <div class="card-image">
          <% if (p.coverImage) { %>
            <img src="<%= p.coverImage %>" alt="<%= p.title %>" loading="lazy" width="400" height="225" decoding="async">
          <% } else { %>
            <div class="no-image"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
          <% } %>
        </div>
        <div class="card-body">
          <span class="badge"><%= (p.category || 'News').toUpperCase() %></span>
          <h3 class="card-title"><a href="/post/<%= p.slug %>"><%= p.title %></a></h3>
          <p class="card-excerpt"><%= p.excerpt %></p>
          <div class="card-meta">
            <span class="author"><%= (p.author || 'Newsroom') %></span>
            <span>·</span>
            <span><%= formatDate(p.createdAt) %></span>
            <span>·</span>
            <span class="read-time"><%= readingTime(p.content) %> min read</span>
            <% if (new Date(p.createdAt) > new Date(Date.now() - 24*60*60*1000)) { %>
              <span class="new-pill">NEW</span>
            <% } %>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ===== TWO COLUMN: Trending Now + Latest News ===== -->
<section style="margin-bottom: 16px;">
  <div class="container">
    <div class="two-col">
      <!-- Trending Now -->
      <div>
        <div class="section-header">
          <div class="section-title-line"><h2 class="section-title">Trending Now</h2></div>
          <a class="section-link" href="/all-stories">View all →</a>
        </div>
        <div class="trending-list">
          <% if (safeTrending.length) { %>
            <% safeTrending.forEach(function(p, i) { %>
            <a href="/post/<%= p.slug %>" class="trending-item">
              <div class="trending-number"><%= String(i + 1).padStart(2, '0') %></div>
              <div class="trending-content">
                <div class="trending-title"><%= p.title %></div>
                <div class="trending-meta">
                  <span class="cat"><%= (p.category || 'News').toUpperCase() %></span>
                  <span>·</span>
                  <span><%= readingTime(p.content) %> min read</span>
                  <% if ((p.views || 0) > 0) { %>
                    <span>·</span>
                    <span class="views"><%= (p.views || 0).toLocaleString() %> views</span>
                  <% } %>
                  <% if (new Date(p.createdAt) > new Date(Date.now() - 24*60*60*1000)) { %>
                    <span class="new-pill">NEW</span>
                  <% } %>
                </div>
              </div>
            </a>
            <% }) %>
          <% } else { %>
            <p style="color:var(--text-muted);font-size:14px;">No trending stories yet.</p>
          <% } %>
        </div>
      </div>

      <!-- Latest News -->
      <div>
        <div class="section-header">
          <div class="section-title-line"><h2 class="section-title">Latest News</h2></div>
        </div>
        <div class="story-list">
          <% if (safePosts.length) { %>
            <% safePosts.slice(0, 6).forEach(function(p) { %>
            <a href="/post/<%= p.slug %>" class="story-item">
              <div class="story-thumb">
                <% if (p.coverImage) { %>
                  <img src="<%= p.coverImage %>" alt="<%= p.title %>" loading="lazy" width="220" height="164" decoding="async">
                <% } else { %>
                  <div class="no-image"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
                <% } %>
              </div>
              <div class="story-content">
                <span class="badge"><%= (p.category || 'News').toUpperCase() %></span>
                <div class="story-title"><%= p.title %></div>
                <div class="story-meta">
                  <span><%= formatDate(p.createdAt) %></span>
                  <span>·</span>
                  <span class="read-time"><%= readingTime(p.content) %> min read</span>
                  <% if (new Date(p.createdAt) > new Date(Date.now() - 24*60*60*1000)) { %>
                    <span class="new-pill">NEW</span>
                  <% } %>
                </div>
              </div>
            </a>
            <% }) %>
          <% } else { %>
            <p style="color:var(--text-muted);font-size:14px;">No latest stories yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== WHAT'S NEW + NEWSLETTER ===== -->
<section style="margin-bottom: 24px;">
  <div class="container">
    <div class="two-col">
      <!-- What's New Feature -->
      <div class="side-feature">
