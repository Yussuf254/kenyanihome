<%- include('partials/head') %>
<% if (typeof featured !== 'undefined' && featured && featured.coverImage) { %>
<link rel="preload" as="image" href="<%= featured.coverImage %>" fetchpriority="high">
<% } %>

<style>
  /* ===== KenyaniHome — Premium News Design System ===== */
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap');

  :root {
    --green: #0B6B3A;
    --green-dark: #084d29;
    --red: #C1121F;
    --red-dark: #9a0e19;
    --white: #FFFFFF;
    --text: #111827;
    --text-secondary: #4b5563;
    --text-muted: #6b7280;
    --bg: #F8F9FA;
    --card-bg: #FFFFFF;
    --border: #e5e7eb;
    --shadow: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.06);
    --shadow-hover: 0 10px 25px rgba(0,0,0,.1), 0 4px 10px rgba(0,0,0,.08);
    --radius: 16px;
    --radius-sm: 8px;
    --transition: 250ms cubic-bezier(.4,0,.2,1);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body {
    font-family: 'Montserrat', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; transition: color var(--transition); }
  img { display: block; max-width: 100%; }

  /* ===== Layout ===== */
  .container { max-width: 1280px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 768px) { .container { padding: 0 24px; } }

  /* ===== Category Badge ===== */
  .badge {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    background: var(--green);
    color: var(--white);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 999px;
    line-height: 1;
    transition: background var(--transition);
  }
  .badge:hover { background: var(--green-dark); }

  /* ===== Hero Section — Premium Editorial ===== */
  .hero {
    margin-bottom: 40px;
    padding: 24px 16px 0;
  }
  @media (min-width: 768px) {
    .hero { padding: 32px 24px 0; margin-bottom: 48px; }
  }
  .hero-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: #1a1a1a;
    box-shadow: var(--shadow);
    transition: box-shadow var(--transition), transform var(--transition);
  }
  .hero-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .hero-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero-image-wrap { aspect-ratio: 21 / 9; }
  }
  .hero-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .hero-card:hover .hero-image-wrap img { transform: scale(1.05); }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.3) 50%, transparent 100%);
  }
  .hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    z-index: 2;
  }
  @media (min-width: 768px) {
    .hero-content { padding: 32px; }
  }
  .hero-content .badge {
    margin-bottom: 12px;
    background: var(--red);
  }
  .hero-content .badge:hover { background: var(--red-dark); }
  .hero-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 22px;
    font-weight: 900;
    line-height: 1.25;
    color: var(--white);
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 4px rgba(0,0,0,.3);
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 32px; }
  }
  .hero-title a:hover { color: #fbbf24; }
  .hero-excerpt {
    font-size: 14px;
    color: rgba(255,255,255,.85);
    line-height: 1.6;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 2px rgba(0,0,0,.3);
  }
  @media (min-width: 768px) {
    .hero-excerpt { font-size: 15px; max-width: 600px; }
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: rgba(255,255,255,.7);
    font-weight: 500;
    flex-wrap: wrap;
  }
  .hero-meta .author { font-weight: 600; color: var(--white); }
  .hero-meta .sep { opacity: .5; }

  /* ===== Breaking News — Clean White ===== */
  .breaking-section {
    margin-bottom: 28px;
    padding: 0 16px;
  }
  @media (min-width: 768px) {
    .breaking-section { padding: 0 24px; }
  }
  .breaking-card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(0,0,0,.05);
    box-shadow: var(--shadow);
    transition: box-shadow var(--transition), transform var(--transition);
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .breaking-card { grid-template-columns: 1.2fr 1fr; }
  }
  .breaking-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--red) 0%, #ff4757 50%, var(--red) 100%);
    z-index: 3;
  }
  .breaking-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .breaking-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f3f4f6;
  }
  @media (min-width: 768px) {
    .breaking-image-wrap { aspect-ratio: 4 / 3; }
  }
  .breaking-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .breaking-card:hover .breaking-image-wrap img { transform: scale(1.03); }
  .breaking-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.35) 0%, rgba(0,0,0,.08) 50%, transparent 100%);
  }
  .breaking-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 14px;
    background: var(--red);
    color: var(--white);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 999px;
    z-index: 2;
    box-shadow: 0 4px 12px rgba(193, 18, 31, .25);
  }
  .breaking-badge::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--white);
    border-radius: 50%;
    animation: blink 1s infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: .3; }
  }
  .breaking-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .breaking-content { padding: 28px; }
  }
  .breaking-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--text);
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .breaking-title { font-size: 24px; }
  }
  .breaking-title a:hover { color: var(--red); }
  .breaking-excerpt {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .breaking-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
    flex-wrap: wrap;
  }
  .breaking-meta .author { font-weight: 600; color: var(--text); }
  .breaking-meta .sep { opacity: .4; }

  /* ===== Section Headers — Award Winning ===== */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    width: 100%;
