<%- include('partials/head') %>

<div id="reading-progress-bar" style="position:fixed; top:0; left:0; height:3px; background:var(--aj-green); width:0%; z-index:1000; transition:width 0.1s linear;"></div>

<script type="application/ld+json"><%- seoSchema %></script>

<style>
    :root {
      --aj-orange: #F9A13A;
      --aj-green: #08783E;
      --aj-red: #E5242A;
      --aj-dark: #111111;
      --aj-gray: #5F6368;
      --aj-light-gray: #E5E7E7;
      --aj-bg: #F5F7F6;
    }

body {
     background: var(--aj-bg) !important;
     font-family: "Source Serif Pro", Georgia, serif !important;
   }

    :root {
     font-family: "Montserrat", sans-serif;
   }

   .aj-article-container {
     width: 100%;
     max-width: 1280px;
     margin: 0 auto;
     padding: 0 24px;
   }

   .aj-editorial-grid {
     display: grid;
     grid-template-columns: minmax(0, 1fr) 340px;
     gap: 40px;
     align-items: start;
   }

   .aj-main-column {
     min-width: 0;
   }

   @media (max-width: 1050px) {
     .aj-editorial-grid {
       grid-template-columns: 1fr;
     }

     .aj-sidebar {
       position: static;
     }
   }

   .aj-content {
     width: 100%;
   }

   .aj-layout {
     display: flex;
     flex-direction: column;
     gap: 34px;
     width: 100%;
   }

  /* Category Tag */
  .aj-category {
    display: inline-block;
    font-family: "Montserrat", sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--aj-dark);
    margin-bottom: 20px;
    padding: 6px 16px;
    background: #F5F7F6;
    border-radius: 4px;
    border-left: 3px solid var(--aj-green);
  }

  /* Headline */
  h1.aj-title {
    font-family: "Montserrat", sans-serif;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--aj-dark);
    margin: 0 0 16px;
    max-width: 820px;
  }

  /* Deck */
  .aj-dek {
    font-family: "Montserrat", sans-serif;
    font-size: clamp(22px, 3vw, 26px);
    font-weight: 400;
    line-height: 1.5;
    color: #5F6368;
    margin: 0 0 32px;
    max-width: 900px;
  }

  /* Byline */
  .aj-byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--aj-light-gray);
    flex-wrap: wrap;
  }

  .aj-byline .aj-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .aj-byline .aj-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e8e1d1, #d4c9a9);
    border: 1px solid #e0d8c5;
    flex-shrink: 0;
  }

  .aj-byline .aj-author-name {
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--aj-dark);
  }

  .aj-byline .aj-meta {
    font-family: "Montserrat", sans-serif;
    font-size: 13px;
    color: #5F6368;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .aj-byline .aj-meta span {
    display: inline;
  }

  /* Section Navigation */
  .aj-section-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: "Montserrat", sans-serif;
    font-size: 13px;
    color: var(--aj-gray);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .aj-section-nav a {
    color: var(--aj-green);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .aj-section-nav a:hover {
    color: var(--aj-red);
  }

  .aj-section-nav .aj-nav-separator {
    color: var(--aj-light-gray);
    font-weight: 400;
  }

   .aj-section-nav .aj-nav-arrow {
     color: var(--aj-gray);
     font-weight: 400;
     margin: 0 4px;
   }

  /* Share Row */
   .aj-share {
     display: flex;
     align-items: center;
     gap: 12px;
     flex-wrap: wrap;
   }

   .aj-share button {
     width: 40px;
     height: 40px;
     border-radius: 4px;
     border: 1px solid var(--aj-light-gray);
     background: #ffffff;
     color: var(--aj-dark);
     cursor: pointer;
     font-size: 16px;
     display: flex;
     align-items: center;
     justify-content: center;
     transition: all 0.2s ease;
   }

   .aj-share button:hover {
     transform: translateY(-1px);
     box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
   }

   /* Branded share buttons */
   .aj-share button[data-share="twitter"] { color: #000000; }
   .aj-share button[data-share="twitter"]:hover { background: #000000; color: #fff; border-color: #000000; }

  .aj-share button[data-share="facebook"] { color: #1877F2; }
  .aj-share button[data-share="facebook"]:hover { background: #1877F2; color: #fff; border-color: #1877F2; }

  .aj-share button[data-share="whatsapp"] { color: #25D369; }
  .aj-share button[data-share="whatsapp"]:hover { background: #25D369; color: #fff; border-color: #25D369; }

  .aj-share button[data-share="copy"] { color: var(--aj-dark); }
   .aj-share button[data-share="copy"]:hover { background: var(--aj-green); color: #fff; border-color: var(--aj-green); }

   /* Featured Media */
   .aj-featured {
     width: 100%;
     aspect-ratio: 16 / 9;
     max-height: 500px;
     overflow: hidden;
     border-radius: 8px;
     margin: 32px 0;
   }

   .aj-featured img {
     width: 100%;
     height: 100%;
     object-fit: cover;
     display: block;
     border-radius: 8px;
   }

   .aj-featured .aj-caption {
     font-family: "Montserrat", sans-serif;
     font-size: 13px;
     color: var(--aj-gray);
     line-height: 1.6;
     margin-top: 8px;
   }

  .aj-featured .aj-caption span {
    color: var(--aj-orange);
    font-weight: 700;
  }

/* Article Body */
   .aj-article-body {
      width: 100%;
      max-width: 760px;
      font-family: "Source Serif Pro", Georgia, serif !important;
      font-size: 20px;
      line-height: 1.78;
      color: var(--aj-dark);
    }

    @media (max-width: 768px) {
      .aj-article-body {
        font-size: 18px;
        line-height: 1.75;
      }
    }

   /* Trix editor paragraphs and regular paragraphs */
   .aj-article-body p,
   .aj-article-body div.paragraph,
   .aj-article-body div.quote-content p {
     margin: 0 0 24px;
     font-family: "Source Serif Pro", Georgia, serif !important;
     font-size: inherit;
     line-height: 1.78;
     color: var(--aj-dark) !important;
   }

    .aj-article-body div.paragraph {
      font-size: inherit;
      line-height: 1.78;
    }

   .aj-article-body h1, .aj-article-body h2,
   .aj-article-body .heading-1, .aj-article-body .heading-2 {
     font-family: "Montserrat", sans-serif !important;
     font-size: 24px !important;
     font-weight: 700 !important;
     margin: 48px 0 20px !important;
     color: var(--aj-dark) !important;
     line-height: 1.3 !important;
   }

   .aj-article-body h3, .aj-article-body .heading-3 {
     font-family: "Montserrat", sans-serif !important;
     font-size: 20px !important;
     font-weight: 600 !important;
     margin: 36px 0 16px !important;
     color: var(--aj-dark) !important;
     line-height: 1.4 !important;
   }

.aj-article-body a {
     color: var(--aj-dark) !important;
     text-decoration: underline !important;
     text-decoration-color: var(--aj-orange) !important;
     text-underline-offset: 3px !important;
     transition: color 0.2s ease !important;
   }

   .aj-article-body a:hover {
     color: var(--aj-red) !important;
   }

   /* Sidebar */
   .aj-sidebar {
     position: sticky;
     top: 100px;
     align-self: start;
     display: flex;
     flex-direction: column;
     gap: 40px;
    }

    .aj-sidebar-section {
     width: 100%;
   }

   .aj-sidebar-title {
     position: relative;
     font-family: "Montserrat", sans-serif;
     font-size: 14px;
     font-weight: 700;
     text-transform: uppercase;
     letter-spacing: 0.5px;
     margin: 0 0 20px;
     padding: 0;
     color: var(--aj-green);
   }

   .aj-sidebar-title::before {
     content: '';
     position: absolute;
     top: 50%;
     left: 0;
     right: 0;
     height: 2px;
     background: var(--aj-green);
     transform: translateY(-50%);
     width: 100%;
     z-index: 1;
   }

   .aj-sidebar-title span {
     position: relative;
     background: #fff;
     padding: 0 8px;
     z-index: 2;
     color: var(--aj-dark);
   }

   .aj-sidebar-story {
     display: flex;
     gap: 12px;
     text-decoration: none;
     padding: 12px 0;
     border-bottom: 1px solid var(--aj-light-gray);
   }

   .aj-sidebar-story:last-child {
     border-bottom: none;
   }

   .aj-sidebar-story-img {
     width: 72px;
     height: 48px;
     border-radius: 4px;
     overflow: hidden;
     flex-shrink: 0;
   }

   .aj-sidebar-story-img img {
     width: 100%;
     height: 100%;
     object-fit: cover;
   }

   .aj-sidebar-story-content {
     flex: 1;
     min-width: 0;
   }

   .aj-sidebar-story-category {
     font-family: "Montserrat", sans-serif;
     font-size: 11px;
     font-weight: 700;
     text-transform: uppercase;
     color: var(--aj-green);
     margin-bottom: 4px;
   }

   .aj-sidebar-story-title {
     font-family: "Montserrat", sans-serif;
     font-size: 14px;
     font-weight: 600;
     line-height: 1.3;
     color: var(--aj-dark);
     margin-bottom: 4px;
   }

   .aj-sidebar-story-title a {
     color: var(--aj-dark);
     text-decoration: none;
   }

   .aj-sidebar-story-title a:hover {
     color: var(--aj-red);
   }

   .aj-sidebar-story-meta {
     font-family: "Montserrat", sans-serif;
     font-size: 12px;
     color: var(--aj-gray);
   }

   .aj-sidebar-item {
     display: flex;
     align-items: center;
     gap: 12px;
     padding: 8px 0;
     border-bottom: 1px solid var(--aj-light-gray);
   }

   .aj-sidebar-item:last-child {
     border-bottom: none;
   }

   .aj-sidebar-item-meta {
     font-family: "Montserrat", sans-serif;
     font-size: 12px;
     color: var(--aj-gray);
     min-width: 80px;
   }

   .aj-sidebar-item-title {
     font-family: "Montserrat", sans-serif;
     font-size: 13px;
     font-weight: 500;
     line-height: 1.4;
     color: var(--aj-dark);
     text-decoration: none;
     flex: 1;
   }

   .aj-sidebar-item-title:hover {
     color: var(--aj-red);
   }

   .aj-sidebar-item-content {
     flex: 1;
     min-width: 0;
   }

   .aj-sidebar-item-category {
     font-family: "Montserrat", sans-serif;
     font-size: 10px;
     font-weight: 700;
     text-transform: uppercase;
     color: var(--aj-gray);
     margin-bottom: 2px;
   }

   .aj-sidebar-number {
     font-family: "Montserrat", sans-serif;
     font-size: 16px;
     font-weight: 800;
     color: var(--aj-gray);
     flex-shrink: 0;
   }

   .aj-sidebar-more {
     display: inline-block;
     font-family: "Montserrat", sans-serif;
     font-size: 12px;
     font-weight: 700;
     color: var(--aj-green);
     text-decoration: none;
     margin-top: 8px;
     text-transform: uppercase;
     letter-spacing: 0.5px;
   }

   .aj-sidebar-more:hover {
     color: var(--aj-red);
   }

   .aj-sidebar-ad {
     margin-top: 20px;
    }

   /* Images in body */
   .aj-article-body img {
     max-width: 100%;
     height: auto;
     display: block;
     margin: 0 auto 20px;
     border-radius: 4px;
   }

  .aj-article-body figcaption {
    font-family: "Inter", sans-serif;
    font-size: 13px;
    color: var(--aj-gray);
    text-align: center;
    font-style: italic;
    margin-top: 6px;
  }

   /* Blockquote / Pull Quote */
   .aj-article-body blockquote,
   .aj-quote {
     margin: 40px auto;
     padding: 0 24px;
     border-left: 4px solid var(--aj-green);
     font-family: "Source Serif Pro", Georgia, serif;
     font-size: clamp(20px, 3vw, 26px);
     font-style: italic;
     line-height: 1.55;
     color: var(--aj-dark);
   }

   .aj-quote .aj-attribution {
     display: block;
     font-family: "Montserrat", sans-serif;
     font-size: 13px;
     font-weight: 600;
     font-style: normal;
     color: var(--aj-gray);
     margin-top: 10px;
   }

    /* Read Also - Inline links between paragraphs */
    .aj-article-body .readalso-section {
      margin: 32px 0 !important;
      padding: 0 !important;
      border: none !important;
    }

    .aj-article-body .readalso-link {
      display: block;
      font-family: "Montserrat", sans-serif !important;
      font-size: 16px !important;
      font-weight: 500 !important;
      line-height: 1.6 !important;
      color: var(--aj-dark) !important;
      text-decoration: none !important;
      margin-bottom: 12px !important;
    }

    .aj-article-body .readalso-link .readalso-label {
      font-weight: 800 !important;
      color: var(--aj-green) !important;
    }

    .aj-article-body .readalso-link .readalso-title {
      font-weight: 500 !important;
      color: var(--aj-dark) !important;
      text-decoration: none !important;
    }

    .aj-article-body .readalso-link:hover {
      color: var(--aj-red) !important;
    }

    .aj-article-body .readalso-link .readalso-arrow {
      color: var(--aj-green);
      font-weight: 700;
    }

   /* Tags */
   .aj-tags {
     margin: 48px 0 0;
     padding: 24px 0 0;
     border-top: 1px solid var(--aj-light-gray);
     max-width: 760px;
     width: 100%;
   }

   .aj-tags-label {
     font-family: "Montserrat", sans-serif;
     font-size: 11px;
     font-weight: 700;
     text-transform: uppercase;
     letter-spacing: 0.5px;
     color: var(--aj-gray);
     margin-bottom: 12px;
     display: block;
   }

   .aj-tag {
     display: inline-block;
     padding: 6px 16px;
     border: none;
     border-radius: 999px;
     font-family: "Montserrat", sans-serif;
     font-size: 12px;
     font-weight: 600;
     color: var(--aj-dark);
     background: var(--aj-green);
     text-decoration: none;
     margin: 0 6px 6px 0;
     transition: all 0.2s ease;
   }

   .aj-tag:hover {
     background: var(--aj-red);
     color: #FFFFFF;
   }

   /* Related Articles */
   .aj-related {
     margin: 48px 0 0;
     padding-top: 32px;
     border-top: 1px solid var(--aj-light-gray);
   }

   .aj-related h2 {
     font-family: "Montserrat", sans-serif;
     font-size: 13px;
     font-weight: 700;
     text-transform: uppercase;
     letter-spacing: 0.5px;
     color: var(--aj-gray);
     margin: 0 0 24px;
   }

  .aj-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .aj-related-grid {
      grid-template-columns: 1fr;
    }
  }

  .aj-related-item {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .aj-related-item img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 8px;
  }

   .aj-related-item .aj-related-title {
     font-family: "Montserrat", sans-serif;
     font-size: 15px;
     font-weight: 600;
     line-height: 1.4;
     color: var(--aj-dark);
     margin-bottom: 4px;
   }

   .aj-related-item .aj-related-meta {
     font-family: "Montserrat", sans-serif;
     font-size: 12px;
     color: var(--aj-gray);
     line-height: 1.4;
   }

   /* Comments */
   .aj-comments-section {
     max-width: 760px;
     margin: 48px 0 0;
     width: 100%;
     padding: 32px 0 0;
     border-top: 1px solid var(--aj-light-gray);
   }

   .aj-comments-section h2 {
     font-family: "Montserrat", sans-serif;
     font-size: 17px;
     font-weight: 700;
     margin: 0 0 20px;
     color: var(--aj-dark);
   }

  .aj-comment {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--aj-light-gray);
  }

  .aj-comment:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

   .aj-comment-author {
     font-family: "Montserrat", sans-serif;
     font-weight: 600;
     color: var(--aj-dark);
     margin-bottom: 4px;
   }

   .aj-comment-date {
     font-family: "Montserrat", sans-serif;
     font-size: 12px;
     color: var(--aj-gray);
     margin-bottom: 8px;
   }

  .aj-comment-body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--aj-dark);
  }

   .aj-no-comments {
     font-family: "Montserrat", sans-serif;
     font-size: 14px;
     color: var(--aj-gray);
     text-align: center;
     padding: 20px 0;
   }

   .aj-comment-form {
     margin-top: 24px;
   }

   .aj-comment-form-row {
     display: grid;
     grid-template-columns: 1fr 1fr;
     gap: 12px;
     margin-bottom: 12px;
   }

   @media (max-width: 768px) {
     .aj-comment-form-row {
       grid-template-columns: 1fr;
     }
   }

   .aj-comment-form input,
   .aj-comment-form textarea {
     width: 100%;
     padding: 10px 12px;
     border: 1px solid var(--aj-light-gray);
     border-radius: 6px;
     font-family: "Montserrat", sans-serif;
     font-size: 14px;
     outline: none;
     resize: vertical;
     transition: border-color 0.2s ease;
   }

   .aj-comment-form input:focus,
   .aj-comment-form textarea:focus {
     border-color: var(--aj-green);
   }

   .aj-comment-form textarea {
     margin-bottom: 12px;
     min-height: 80px;
   }

    .aj-comment-submit {
      padding: 10px 24px;
      border: none;
      border-radius: 4px;
      background: var(--aj-green);
      color: #fff;
      font-family: "Montserrat", sans-serif;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-bottom: 24px;
    }

   .aj-comment-submit:hover {
     background: #065f30;
   }

   /* Ad Container */
   .aj-ad-container {
     max-width: 720px;
     margin: 32px auto;
     width: 100%;
     box-sizing: border-box;
   }

   @media (max-width: 768px) {
     .aj-ad-container {
       width: 100%;
     }
   }

   .aj-comment-status {
     margin-top: 12px;
     font-size: 12px;
     font-family: "Inter", sans-serif;
     display: none;
   }

   .aj-comment-submit:hover {
     background: #0a4f25;
   }

   /* Paywall */
  .aj-paywall {
    position: relative;
  }

  .aj-paywall.is-locked {
    filter: blur(8px);
    user-select: none;
  }

  .aj-paywall-overlay {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.92);
    z-index: 5;
    align-items: flex-start;
    justify-content: center;
    padding-top: 18vh;
  }

  .aj-paywall-overlay.is-visible {
    display: flex;
  }

  .aj-paywall-card {
    background: #fff;
    border: 1px solid var(--aj-light-gray);
    border-radius: 12px;
    padding: 28px;
    max-width: 420px;
    width: 92%;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
  }

   .aj-paywall-card h3 {
     font-family: "Montserrat", sans-serif;
     font-size: 20px;
     font-weight: 700;
     margin: 0 0 8px;
     color: var(--aj-dark);
   }

   .aj-paywall-card p {
     font-family: "Montserrat", sans-serif;
     font-size: 14px;
     color: var(--aj-gray);
     line-height: 1.6;
     margin: 0 0 18px;
   }

   .aj-paywall-card .price {
     font-family: "Montserrat", sans-serif;
     font-size: 28px;
     font-weight: 800;
     color: var(--aj-green);
     margin-bottom: 14px;
   }

   .aj-paywall-card .price small {
     font-size: 13px;
     font-weight: 500;
     color: var(--aj-gray);
   }

   .aj-paywall-input {
     width: 100%;
     padding: 12px 14px;
     border: 1px solid var(--aj-light-gray);
     border-radius: 6px;
     font-family: "Montserrat", sans-serif;
     font-size: 14px;
     outline: none;
     margin-bottom: 10px;
     transition: border-color 0.2s ease;
   }

   .aj-paywall-input:focus {
     border-color: var(--aj-green);
   }

   .aj-paywall-btn {
     width: 100%;
     padding: 12px;
     border: 0;
     border-radius: 4px;
     background: var(--aj-green);
     color: #fff;
     font-family: "Montserrat", sans-serif;
     font-weight: 700;
     font-size: 14px;
     cursor: pointer;
     transition: background 0.2s ease;
   }

   .aj-paywall-btn:hover {
     background: #065f30;
   }

  .aj-paywall-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .aj-paywall-msg {
    margin-top: 10px;
    font-size: 12px;
    display: none;
   }

  @media (max-width: 768px) {
   .aj-byline {
     flex-direction: column;
     align-items: flex-start;
     gap: 16px;
     padding-bottom: 16px;
   }

   .aj-share {
     justify-content: flex-start;
     width: 100%;
     flex-wrap: wrap;
     gap: 10px;
     flex-direction: row;
   }

   .aj-share button {
     width: 36px;
     height: 36px;
     font-size: 14px;
   }

   .aj-section-nav {
     font-size: 12px;
     gap: 4px;
   }

   .aj-comment-submit {
     width: auto;
     padding: 10px 24px;
   }
 }
</style>

<main>
   <div class="aj-article-container">

      <!-- Story Header & Main Content Grid -->
      <div class="aj-editorial-grid">
        <div class="aj-main-column">

          <!-- Section Navigation -->
          <nav class="aj-section-nav" aria-label="section navigation">
            <a href="/">Home</a>
            <span class="aj-nav-arrow">›</span>
            <a href="/category/<%= post.category %>"><%= post.category.charAt(0).toUpperCase() + post.category.slice(1) %></a>
            <span class="aj-nav-arrow">›</span>
             <span style="color: var(--aj-dark); font-weight: 500;"><%= post.title.length > 50 ? post.title.substring(0, 50) + '...' : post.title %></span>
          </nav>

        <!-- Category Tag -->
        <div class="aj-category"><%= post.category.toUpperCase() %></div>

       <!-- Headline -->
       <h1 class="aj-title"><%= post.title %></h1>

       <!-- Deck -->
       <p class="aj-dek"><%= post.excerpt %></p>

       <!-- Byline -->
       <div class="aj-byline">
         <div class="aj-author">
           <div class="aj-avatar"></div>
           <div>
             <div class="aj-author-name">By <%= post.author %></div>
             <div class="aj-meta">
               <span>Published: <%= formatDate(post.createdAt) %></span>
               <span class="aj-separator">·</span>
               <span>Updated: <%= post.updatedAt ? formatDate(post.updatedAt) : formatDate(post.createdAt) %></span>
               <span class="aj-separator">·</span>
               <span><%= readingTime(post.content) %> min read</span>
               <span class="aj-separator">·</span>
               <span id="share-count"><%= post.shares || 0 %> shares</span>
             </div>
           </div>
         </div>

         <!-- Social Share -->
         <div class="aj-share">
           <button type="button" data-share="twitter" title="Share on X">
             <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
           </button>
           <button type="button" data-share="facebook" title="Share on Facebook">
             <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
           </button>
           <button type="button" data-share="whatsapp" title="Share on WhatsApp">
             <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
           </button>
           <button type="button" data-share="copy" title="Copy link">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
           </button>
         </div>
       </div>

        <!-- Featured Media -->
        <% if (post.coverImage) { %>
        <div class="aj-featured">
          <img src="<%= post.coverImage %>" alt="<%= post.title %>" onerror="this.onerror=null;this.src='/assets/img/post/list/1.png';" loading="lazy">
          <% if (post.photoCredit) { %>
          <div class="aj-caption"><span>PHOTO | PCS</span> <%= post.photoCredit %></div>
          <% } %>
        </div>
        <% } %>

        <!-- Article Body -->
        <article class="aj-article-body" id="article-body">
          <div class="aj-paywall-content" id="paywall-content">
            <%- post.content %>
          </div>
          <% if (paywallActive) { %>
          <div class="aj-paywall-overlay" id="paywall-overlay">
            <div class="aj-paywall-card">
              <h3>Continue reading</h3>
              <p>You have reached your free article limit. Unlock this story to keep reading.</p>
              <div class="price"><%= paywallCurrency %> <%= paywallPrice %> <small>one-time unlock</small></div>
              <form id="paywall-form">
               <input type="tel" class="aj-paywall-input" id="paywall-phone" placeholder="M-Pesa phone number (e.g. 254712345678)" required>
               <button type="submit" class="aj-paywall-btn" id="paywall-btn">Unlock with M-Pesa</button>
               <p class="aj-paywall-msg" id="paywall-msg"></p>
             </form>
           </div>
         </div>
         <% } %>
       </article>

       <!-- Tags -->
       <% if (post.tags && post.tags.length) { %>
       <div class="aj-tags">
         <span class="aj-tags-label">Topics</span>
         <% post.tags.forEach(function(t) { %>
           <a href="/search?q=<%= encodeURIComponent(t) %>" class="aj-tag"><%= t %></a>
         <% }) %>
       </div>
       <% } %>

       <!-- Comments Section -->
       <section class="aj-comments-section">
         <h2>Comments</h2>
         <div id="comments-list">
           <% if (comments && comments.length) { %>
             <% comments.forEach(function(c) { %>
             <div class="aj-comment">
               <div class="aj-comment-author"><%= c.name || 'Anonymous' %></div>
               <div class="aj-comment-date"><%= new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
               <div class="aj-comment-body"><%= c.body %></div>
             </div>
             <% }) %>
           <% } else { %>
             <p class="aj-no-comments">No comments yet. Be the first to share your thoughts.</p>
           <% } %>
         </div>
         <form id="comment-form" class="aj-comment-form">
           <div class="aj-comment-form-row">
             <input type="text" id="comment-name" name="name" placeholder="Your name" required>
             <input type="email" id="comment-email" name="email" placeholder="Your email (not published)" required>
           </div>
           <textarea id="comment-body" name="body" rows="3" placeholder="Write your comment..." required></textarea>
           <button type="submit" class="aj-comment-submit">Post Comment</button>
           <p id="comment-status" class="aj-comment-status"></p>
         </form>
       </section>

        <!-- Advertisement -->
        <% if (inlineAd) { %>
        <div class="aj-ad-container">
          <%- include('partials/ad-card', { ad: inlineAd }) %>
        </div>
        <% } %>

       </div>

        <!-- Sidebar -->
        <aside class="aj-sidebar">
          <% if (related && related.length) { %>
          <div class="aj-sidebar-section">
            <div class="aj-sidebar-title"><span>World</span></div>
            <% if (related[0]) { %>
            <div class="aj-sidebar-story">
              <% if (related[0].coverImage) { %>
              <div class="aj-sidebar-story-img">
                <img src="<%= related[0].coverImage %>" alt="<%= related[0].title %>" loading="lazy" onerror="this.onerror=null;this.src='/assets/img/post/list/1.png';">
              </div>
              <% } %>
              <div class="aj-sidebar-story-content">
                <div class="aj-sidebar-story-category"><%= related[0].category %></div>
                <div class="aj-sidebar-story-title"><a href="/post/<%= related[0].slug %>"><%= related[0].title %></a></div>
                <div class="aj-sidebar-story-meta"><%= formatDate(related[0].createdAt) %></div>
              </div>
            </div>
            <% } %>
            <% related.slice(1, 4).forEach(function(r) { %>
            <a href="/post/<%= r.slug %>" class="aj-sidebar-item">
              <span class="aj-sidebar-item-meta"><%= formatDate(r.createdAt) %></span>
              <span class="aj-sidebar-item-title"><%= r.title.length > 70 ? r.title.substring(0, 70) + '...' : r.title %></span>
            </a>
            <% }) %>
          </div>
          <% } %>

          <% if (typeof trending !== 'undefined' && trending.length) { %>
          <div class="aj-sidebar-section">
            <div class="aj-sidebar-title"><span>Most Read</span></div>
            <% trending.slice(0, 5).forEach(function(t, idx) { %>
            <div class="aj-sidebar-item">
              <span class="aj-sidebar-number"><%= String(idx + 1).padStart(2, '0') %></span>
              <div class="aj-sidebar-item-content">
                <div class="aj-sidebar-item-category"><%= t.category %></div>
                <a href="/post/<%= t.slug %>" class="aj-sidebar-item-title"><%= t.title.length > 60 ? t.title.substring(0, 60) + '...' : t.title %></a>
                <div class="aj-sidebar-item-meta"><%= readingTime(t.content) %> min read</div>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>

          <% if (typeof featuredStories !== 'undefined' && featuredStories.length) { %>
          <div class="aj-sidebar-section">
            <div class="aj-sidebar-title"><span>Latest Updates</span></div>
            <% featuredStories.slice(0, 4).forEach(function(f) { %>
            <a href="/post/<%= f.slug %>" class="aj-sidebar-item">
              <span class="aj-sidebar-item-meta"><%= formatDate(f.createdAt) %></span>
              <span class="aj-sidebar-item-title"><%= f.title.length > 70 ? f.title.substring(0, 70) + '...' : f.title %></span>
            </a>
            <% }) %>
          </div>
          <% } %>

          <% if (typeof sidebarAd !== 'undefined' && sidebarAd) { %>
          <div class="aj-sidebar-ad">
            <%- include('partials/ad-card', { ad: sidebarAd }) %>
          </div>
          <% } %>
        </aside>
      </div>
      </main>

<script>
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
    const bar = document.getElementById('reading-progress-bar');
   if (bar) bar.style.width = scrolled + '%';
   });

   document.querySelectorAll('[data-share]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const platform = btn.dataset.share;
      const url = window.location.href;
      const title = <%- JSON.stringify(post.title) %>;
      let shareUrl = '';
      if (platform === 'twitter') shareUrl = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(url);
      else if (platform === 'facebook') shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);
      else if (platform === 'whatsapp') shareUrl = 'https://wa.me/?text=' + encodeURIComponent(title + ' ' + url);
      else if (platform === 'copy') { navigator.clipboard.writeText(url); btn.textContent = '✓'; setTimeout(() => btn.textContent = '', 1500); return; }
       if (shareUrl) window.open(shareUrl, '_blank', 'width=600,height=500');
       fetch('/post/<%= post.slug %>/share', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ platform }) }).then(r => r.json()).then(data => { if (data.ok) document.getElementById('share-count').textContent = data.shares + ' shares'; }).catch(() => {});
     });
   });

   const commentForm = document.getElementById('comment-form');
  if (commentForm) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
    });
  }
</script>

<%- include('partials/foot') %>
