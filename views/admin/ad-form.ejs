<%- include('partials/head') %>
<%- include('partials/topbar', { heading: ad ? 'Edit Ad' : 'New Ad', crumb: 'Advertising' }) %>

  <form
    action="<%= ad ? `/admin/ads/${ad.id}?_method=PUT` : '/admin/ads' %>"
    method="post"
    enctype="multipart/form-data"
  >
    <div class="admin-split">
      <div>
        <div class="form-section">
          <div class="form-section-head">Sponsor Details</div>
          <div class="form-section-body">
            <div class="field">
              <label>Ad Title</label>
              <input type="text" name="title" required value="<%= ad ? ad.title : '' %>" placeholder="e.g. Weekend Reading List, presented by...">
            </div>
            <div class="field">
              <label>Description</label>
              <textarea name="description" rows="3" placeholder="A short line about the product or offer."><%= ad ? ad.description : '' %></textarea>
            </div>
            <div class="field">
              <label>Destination Link</label>
              <input type="text" name="link" value="<%= ad ? ad.link : '' %>" placeholder="https://advertiser.example.com">
              <p class="help">Clicks on the ad are tracked, then redirect here.</p>
            </div>
            <div class="field">
              <label>Video URL (optional)</label>
              <input type="text" name="videoUrl" value="<%= ad ? ad.videoUrl : '' %>" placeholder="YouTube or Vimeo link — shown instead of the image if set">
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="form-section">
          <div class="form-section-head">Placement</div>
          <div class="form-section-body">
            <div class="field">
              <label>Where it shows</label>
              <select name="placement">
                <option value="sidebar" <%= ad && ad.placement === 'sidebar' ? 'selected' : '' %>>Sidebar (homepage)</option>
                <option value="inline" <%= ad && ad.placement === 'inline' ? 'selected' : '' %>>In-article (below story body)</option>
                <option value="both" <%= ad && ad.placement === 'both' ? 'selected' : '' %>>Both</option>
                <option value="brand" <%= ad && ad.placement === 'brand' ? 'selected' : '' %>>Brand (Advertised Products page)</option>
              </select>
            </div>
            <div class="checkbox-field field">
              <input type="checkbox" name="active" id="active" <%= !ad || ad.active ? 'checked' : '' %>>
              <label for="active" style="margin:0;">Active — show on the live site</label>
            </div>
            <div class="form-actions" style="border:none; padding-top:10px;">
              <a href="/admin/ads" class="btn btn-ghost btn-sm">Cancel</a>
              <button type="submit" class="btn btn-signal"><i class="bi bi-megaphone"></i>&nbsp; <%= ad ? 'Save Changes' : 'Create Ad' %></button>
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-head">Ad Image</div>
          <div class="form-section-body">
            <div class="cover-picker">
              <% if (ad && ad.imageUrl) { %>
                <img class="cover-preview" id="cover-preview" src="<%= ad.imageUrl %>">
              <% } else { %>
                <div class="cover-preview-empty" id="cover-preview-empty"><i class="bi bi-image"></i></div>
                <img class="cover-preview" id="cover-preview" style="display:none;">
              <% } %>
              <input type="hidden" name="imageUrl" id="imageUrl" value="<%= ad ? ad.imageUrl : '' %>">
              <input type="file" name="imageFile" id="imageFile" accept="image/*,.jfif" style="width:100%; font-size:12px;">
              <p class="help">Upload an image, or <button type="button" id="pick-from-library" style="background:none;border:none;color:var(--signal);cursor:pointer;padding:0;font:inherit;">choose from your media library</button>. Ignored if a video URL is set.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <div id="media-modal" style="display:none; position:fixed; inset:0; background:rgba(21,24,29,.6); z-index:100; align-items:center; justify-content:center;">
    <div style="background:#fff; width:720px; max-width:92vw; max-height:80vh; overflow-y:auto; padding:24px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
        <h3 style="font-family:var(--font-display); margin:0;">Choose an image</h3>
        <button type="button" id="close-modal" class="icon-btn"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="media-grid" id="modal-media-grid">
        <% media.forEach(m => { %>
          <div class="media-item" data-url="<%= m.url %>" style="cursor:pointer;"><img src="<%= m.url %>"></div>
        <% }) %>
        <% if (!media.length) { %><p style="color:var(--grey); grid-column:1/-1;">No images uploaded yet.</p><% } %>
      </div>
    </div>
  </div>

<%- include('partials/foot') %>

<script>
  const modal = document.getElementById('media-modal');
  document.getElementById('pick-from-library').addEventListener('click', () => { modal.style.display = 'flex'; });
  document.getElementById('close-modal').addEventListener('click', () => (modal.style.display = 'none'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });
  document.getElementById('modal-media-grid').addEventListener('click', (e) => {
    const item = e.target.closest('.media-item');
    if (!item) return;
    const url = item.dataset.url;
    document.getElementById('imageUrl').value = url;
    document.getElementById('imageFile').value = '';
    const preview = document.getElementById('cover-preview');
    const empty = document.getElementById('cover-preview-empty');
    preview.src = url;
    preview.style.display = 'block';
    if (empty) empty.style.display = 'none';
    modal.style.display = 'none';
  });
  document.getElementById('imageFile').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const preview = document.getElementById('cover-preview');
    const empty = document.getElementById('cover-preview-empty');
    preview.src = URL.createObjectURL(file);
    preview.style.display = 'block';
    if (empty) empty.style.display = 'none';
  });
</script>
