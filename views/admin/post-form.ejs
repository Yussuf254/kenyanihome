<%- include('partials/head') %>
<%- include('partials/topbar', { heading: post ? 'Edit Post' : 'New Post', crumb: 'Posts' }) %>

  <form
    action="<%= post ? `/admin/posts/${post.id}?_method=PUT` : '/admin/posts' %>"
    method="post"
    enctype="multipart/form-data"
    id="post-form"
  >
    <div class="admin-split mobile-stack">
      <!-- MAIN COLUMN -->
      <div>
        <div class="form-section">
          <div class="form-section-body">
            <div class="field">
              <label>Headline</label>
              <input type="text" name="title" required value="<%= post ? post.title : '' %>" placeholder="Write a clear, specific headline" style="font-family: var(--font-display); font-size: 20px; padding: 14px 15px;">
            </div>
            <div class="field">
              <label>Deck / Excerpt</label>
              <textarea name="excerpt" rows="2" placeholder="A one or two sentence summary shown on cards and social shares. Leave blank to auto-generate."><%= post ? post.excerpt : '' %></textarea>
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-head">Story Body</div>
          <div class="form-section-body" style="padding-top:16px;">
            <div class="editor-toolbar" id="editor-toolbar">
              <button type="button" data-cmd="bold" title="Bold"><i class="bi bi-type-bold"></i></button>
              <button type="button" data-cmd="italic" title="Italic"><i class="bi bi-type-italic"></i></button>
              <button type="button" data-cmd="formatBlock" data-val="H2" title="Heading">H2</button>
              <button type="button" data-cmd="formatBlock" data-val="H3" title="Subheading">H3</button>
              <button type="button" data-cmd="formatBlock" data-val="BLOCKQUOTE" title="Quote"><i class="bi bi-quote"></i></button>
              <button type="button" data-cmd="insertUnorderedList" title="Bulleted list"><i class="bi bi-list-ul"></i></button>
              <button type="button" data-cmd="insertOrderedList" title="Numbered list"><i class="bi bi-list-ol"></i></button>
              <button type="button" data-cmd="createLink" title="Link"><i class="bi bi-link-45deg"></i></button>
              <button type="button" id="insert-image-btn" title="Insert image"><i class="bi bi-image"></i></button>
              <button type="button" data-cmd="imageAlign" data-val="left" title="Align image left"><i class="bi bi-align-start"></i></button>
              <button type="button" data-cmd="imageAlign" data-val="right" title="Align image right"><i class="bi bi-align-end"></i></button>
              <button type="button" data-cmd="imageAlign" data-val="center" title="Center image"><i class="bi bi-align-center"></i></button>
              <button type="button" id="insert-video-btn" title="Embed YouTube/Vimeo video"><i class="bi bi-camera-reels"></i></button>
              <button type="button" data-cmd="formatBlock" data-val="P" title="Paragraph"><i class="bi bi-paragraph"></i></button>
              <button type="button" data-cmd="removeFormat" title="Clear formatting"><i class="bi bi-eraser"></i></button>
              <button type="button" id="insert-doc-btn" title="Attach document (PDF, Word)"><i class="bi bi-paperclip"></i></button>
            </div>
            <input type="file" id="documentFile" name="documentFile" accept=".pdf,.doc,.docx" multiple style="display:none;">
            <div class="doc-list" id="doc-list"></div>
            <div class="editor-surface" id="editor-surface" contenteditable="true"><%- post ? post.content : '<p>Start writing your story…</p>' %></div>
            <textarea name="content" id="content-field" style="display:none;"></textarea>
            <p class="help">Select text and use the toolbar to format. Click the image icon to insert a photo from your media library.</p>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-body">
            <div class="field">
              <label>Tags</label>
              <input type="text" name="tags" value="<%= post && post.tags ? post.tags.join(', ') : '' %>" placeholder="comma, separated, tags">
            </div>
          </div>
        </div>
      </div>

      <!-- SIDEBAR COLUMN -->
      <div>
        <div class="form-section">
          <div class="form-section-head">Actions</div>
          <div class="form-section-body">
            <div class="field">
              <label>Status</label>
              <select name="status" id="status-select">
                <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
                <option value="scheduled" <%= post && post.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
                <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
              </select>
            </div>
            <div class="field" id="publish-at-field" style="<%= post && post.status === 'scheduled' ? '' : 'display:none;' %>">
              <label>Publish On</label>
              <input type="datetime-local" name="publishAt" value="<%= post && post.publishAt ? new Date(post.publishAt).toISOString().slice(0,16) : '' %>">
              <p class="help">The post stays hidden until this date and time, then publishes automatically.</p>
            </div>
            <div class="checkbox-field field">
              <input type="checkbox" name="featured" id="featured" <%= post && post.featured ? 'checked' : '' %>>
              <label for="featured" style="margin:0;">Feature on homepage</label>
            </div>
            <div class="checkbox-field field">
              <input type="checkbox" name="sponsored" id="sponsored" <%= post && post.sponsored ? 'checked' : '' %>>
              <label for="sponsored" style="margin:0;">Mark as sponsored content</label>
            </div>
            <div class="checkbox-field field">
              <input type="checkbox" name="breaking" id="breaking" <%= post && post.breaking ? 'checked' : '' %>>
              <label for="breaking" style="margin:0;">Mark as breaking news</label>
            </div>
            <div class="field" id="breakingExpiryField" style="<%= post && post.breaking ? '' : 'display:none;' %>">
              <label>Breaking Expiry (optional)</label>
              <input type="datetime-local" name="breakingExpiry" value="<%= post && post.breakingExpiry ? new Date(post.breakingExpiry).toISOString().slice(0,16) : '' %>">
              <p class="help">Leave empty for no expiry. Post will automatically stop showing as breaking after this date/time.</p>
            </div>
            <div class="checkbox-field field">
              <input type="checkbox" name="trending" id="trending" <%= post && post.trending ? 'checked' : '' %>>
              <label for="trending" style="margin:0;">Show in Trending Now</label>
            </div>
            <div class="form-actions" style="border:none; padding-top:10px;">
              <a href="/admin/posts" class="btn btn-ghost btn-sm">Cancel</a>
              <button type="submit" class="btn btn-signal"><i class="bi bi-newspaper"></i>&nbsp; <%= post ? 'Save Changes' : 'Create Post' %></button>
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-head">Details</div>
          <div class="form-section-body">
            <div class="field">
              <label>Category</label>
              <select name="category">
                <% categories.forEach(c => { %>
                  <option value="<%= c.slug %>" <%= post && post.category === c.slug ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="field">
              <label>Byline (Author)</label>
              <input type="text" name="author" value="<%= post ? post.author : 'Newsroom Staff' %>">
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-head">Cover Image</div>
          <div class="form-section-body">
            <div class="cover-picker">
              <% if (post && post.coverImage) { %>
                <img class="cover-preview" id="cover-preview" src="<%= post.coverImage %>">
              <% } else { %>
                <div class="cover-preview-empty" id="cover-preview-empty"><i class="bi bi-image"></i></div>
                <img class="cover-preview" id="cover-preview" style="display:none;">
              <% } %>
              <input type="hidden" name="coverImageUrl" id="coverImageUrl" value="<%= post ? post.coverImage : '' %>">
              <input type="file" name="coverImageFile" id="coverImageFile" accept="image/*,.jfif" style="width:100%; font-size:12px;">
              <p class="help">Upload a new image, or <button type="button" id="pick-from-library" style="background:none;border:none;color:var(--signal);cursor:pointer;padding:0;font:inherit;">choose from your media library</button>.</p>
            </div>
            <div class="field" style="margin-top:12px;">
              <label>Photo Credit</label>
              <input type="text" name="photoCredit" value="<%= post ? post.photoCredit || '' : '' %>" placeholder="e.g. Getty Images / John Doe">
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-head">Photo Gallery</div>
          <div class="form-section-body">
            <div class="media-grid" id="gallery-picker-grid" style="margin-bottom:12px;">
              <% (post && post.gallery ? post.gallery : []).forEach(url => { %>
                <div class="media-item gallery-picked" data-url="<%= url %>">
                  <img src="<%= url %>">
                  <div class="m-actions"><button type="button" class="gallery-remove" title="Remove"><i class="bi bi-x-lg"></i></button></div>
                </div>
              <% }) %>
            </div>
            <input type="hidden" name="galleryUrls" id="galleryUrls" value="<%= JSON.stringify(post && post.gallery ? post.gallery : []) %>">
            <button type="button" id="add-gallery-images" class="btn btn-ghost btn-sm btn-block"><i class="bi bi-images"></i>&nbsp; Add Images from Library</button>
            <p class="help">Shown as a lightbox carousel on the published story, below the body text.</p>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-head">Audio Narration</div>
          <div class="form-section-body">
            <div class="field">
              <label>Upload Audio File</label>
              <input type="file" name="audioFile" accept="audio/*" style="width:100%; font-size:12px;">
              <p class="help">MP3, WAV, M4A or OGG. Adds a "Listen to this story" player to the published post.</p>
            </div>
            <div class="field">
              <label>...or Audio URL</label>
              <input type="text" name="audioUrl" value="<%= post ? post.audioUrl : '' %>" placeholder="https://.../narration.mp3">
              <% if (post && post.audioUrl) { %><p class="help">Current: <a href="<%= post.audioUrl %>" target="_blank" style="color:var(--signal);"><%= post.audioUrl %></a></p><% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <!-- Media picker modal -->
  <div id="media-modal" style="display:none; position:fixed; inset:0; background:rgba(21,24,29,.6); z-index:100; align-items:center; justify-content:center;">
    <div style="background:#fff; width:720px; max-width:92vw; max-height:80vh; overflow-y:auto; padding:24px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
        <h3 style="font-family:var(--font-display); margin:0;">Choose an image</h3>
        <button type="button" id="close-modal" class="icon-btn"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="media-grid" id="modal-media-grid">
        <% media.forEach(m => { %>
          <div class="media-item" data-url="<%= m.url %>" style="cursor:pointer;">
            <img src="<%= m.url %>">
          </div>
        <% }) %>
        <% if (!media.length) { %><p style="color:var(--grey); grid-column:1/-1;">No images uploaded yet. Upload one from the Media Library.</p><% } %>
      </div>
    </div>
  </div>

<%- include('partials/foot') %>

<script>
  // ---- rich text toolbar ----
  const surface = document.getElementById('editor-surface');
  document.getElementById('editor-toolbar').addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-cmd]');
    if (!btn) return;
    surface.focus();
    const cmd = btn.dataset.cmd;
    if (cmd === 'createLink') {
      const url = prompt('Link URL:', 'https://');
      if (url) document.execCommand(cmd, false, url);
    } else if (cmd === 'imageAlign') {
      const val = btn.dataset.val || 'left';
      const alignClass = 'content-img-' + val;
      const sel = window.getSelection();
      if (sel.rangeCount > 0) {
        let node = sel.anchorNode;
        while (node && node !== surface) {
          if (node.nodeName === 'IMG') {
            node.className = alignClass;
            return;
          }
          node = node.parentNode;
        }
      }
    } else {
      document.execCommand(cmd, false, btn.dataset.val || null);
    }
  });

  surface.addEventListener('click', (e) => {
    if (e.target.tagName === 'IMG') {
      e.preventDefault();
      const range = document.createRange();
      range.selectNode(e.target);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }
  });

  // ---- insert image into editor body ----
  const modal = document.getElementById('media-modal');
  let modalTarget = 'editor'; // 'editor' | 'cover' | 'gallery'
  document.getElementById('insert-image-btn').addEventListener('click', () => {
    modalTarget = 'editor';
    modal.style.display = 'flex';
  });
  document.getElementById('pick-from-library').addEventListener('click', () => {
    modalTarget = 'cover';
    modal.style.display = 'flex';
  });
  document.getElementById('add-gallery-images').addEventListener('click', () => {
    modalTarget = 'gallery';
    modal.style.display = 'flex';
  });
  document.getElementById('close-modal').addEventListener('click', () => (modal.style.display = 'none'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });

  // ---- video embed (YouTube/Vimeo) ----
  document.getElementById('insert-video-btn').addEventListener('click', () => {
    const url = prompt('Paste a YouTube or Vimeo link:', 'https://');
    if (!url) return;
    let embedSrc = url;
    const yt = url.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=|youtube\.com\/embed\/)([\w-]{6,})/);
    const vm = url.match(/vimeo\.com\/(\d+)/);
    if (yt) embedSrc = 'https://www.youtube.com/embed/' + yt[1];
    else if (vm) embedSrc = 'https://player.vimeo.com/video/' + vm[1];
    surface.focus();
    document.execCommand(
      'insertHTML',
      false,
      `<div class="video-embed"><iframe src="${embedSrc}" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe></div><p><br></p>`
    );
  });

  // ---- gallery picker ----
  const galleryGrid = document.getElementById('gallery-picker-grid');
  const galleryUrlsField = document.getElementById('galleryUrls');
  function getGalleryUrls() {
    try { return JSON.parse(galleryUrlsField.value || '[]'); } catch (e) { return []; }
  }
  function renderGalleryThumb(url) {
    const div = document.createElement('div');
    div.className = 'media-item gallery-picked';
    div.dataset.url = url;
    div.innerHTML = `<img src="${url}"><div class="m-actions"><button type="button" class="gallery-remove" title="Remove"><i class="bi bi-x-lg"></i></button></div>`;
    return div;
  }
  galleryGrid.addEventListener('click', (e) => {
    const btn = e.target.closest('.gallery-remove');
    if (!btn) return;
    const item = btn.closest('.gallery-picked');
    const url = item.dataset.url;
    const urls = getGalleryUrls().filter((u) => u !== url);
    galleryUrlsField.value = JSON.stringify(urls);
    item.remove();
  });

  document.getElementById('modal-media-grid').addEventListener('click', (e) => {
    const item = e.target.closest('.media-item');
    if (!item) return;
    const url = item.dataset.url;
    if (modalTarget === 'editor') {
      surface.focus();
      document.execCommand('insertHTML', false, `<img class="content-img-left" src="${url}" alt="">`);
    } else if (modalTarget === 'gallery') {
      const urls = getGalleryUrls();
      if (!urls.includes(url)) {
        urls.push(url);
        galleryUrlsField.value = JSON.stringify(urls);
        galleryGrid.appendChild(renderGalleryThumb(url));
      }
      return; // stay open so multiple images can be picked in one go
    } else {
      document.getElementById('coverImageUrl').value = url;
      document.getElementById('coverImageFile').value = '';
      const preview = document.getElementById('cover-preview');
      const empty = document.getElementById('cover-preview-empty');
      preview.src = url;
      preview.style.display = 'block';
      if (empty) empty.style.display = 'none';
    }
    modal.style.display = 'none';
  });

  // preview uploaded cover file before submit
  document.getElementById('coverImageFile').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const preview = document.getElementById('cover-preview');
    const empty = document.getElementById('cover-preview-empty');
    preview.src = URL.createObjectURL(file);
    preview.style.display = 'block';
    if (empty) empty.style.display = 'none';
  });

  // sync contenteditable HTML into hidden textarea before submit
  document.getElementById('post-form').addEventListener('submit', () => {
    document.getElementById('content-field').value = surface.innerHTML;
  });

  // show/hide the "Publish On" date field based on status
  const statusSelect = document.getElementById('status-select');
  const publishAtField = document.getElementById('publish-at-field');
  statusSelect.addEventListener('change', () => {
    publishAtField.style.display = statusSelect.value === 'scheduled' ? 'block' : 'none';
  });

  // ---- document attachments ----
  const docInput = document.getElementById('documentFile');
  const docList = document.getElementById('doc-list');
  const existingDocs = <%- post && post.documents ? JSON.stringify(post.documents) : '[]' %>;
  let docs = [...existingDocs];

  function renderDocs() {
    docList.innerHTML = '';
    docs.forEach((doc, i) => {
      const item = document.createElement('div');
      item.className = 'doc-item';
      item.innerHTML = `<div class="doc-icon"><i class="bi bi-file-earmark-text"></i></div><div class="doc-name">${doc.name}</div><button type="button" class="doc-remove" data-index="${i}" title="Remove"><i class="bi bi-x-lg"></i></button>`;
      docList.appendChild(item);
    });
  }
  renderDocs();

  document.getElementById('insert-doc-btn').addEventListener('click', () => docInput.click());
  docInput.addEventListener('change', () => {
    Array.from(docInput.files).forEach(f => {
      docs.push({ name: f.name, url: URL.createObjectURL(f), size: f.size });
    });
    docInput.value = '';
    renderDocs();
  });
  docList.addEventListener('click', (e) => {
    const btn = e.target.closest('.doc-remove');
    if (!btn) return;
    const idx = Number(btn.dataset.index);
    docs[idx]._delete = true;
    btn.closest('.doc-item').style.opacity = '0.4';
    btn.disabled = true;
  });

  document.getElementById('post-form').addEventListener('submit', () => {
    document.getElementById('content-field').value = surface.innerHTML;
    docs.forEach((d, i) => {
      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'documents[' + i + '][name]';
      hidden.value = d.name;
      document.getElementById('post-form').appendChild(hidden);
      if (d._delete) {
        const del = document.createElement('input');
        del.type = 'hidden';
        del.name = 'documents[' + i + '][_delete]';
        del.value = '1';
        document.getElementById('post-form').appendChild(del);
      }
    });
  });

  const breakingCheckbox = document.getElementById('breaking');
  const breakingExpiryField = document.getElementById('breakingExpiryField');
  breakingCheckbox.addEventListener('change', () => {
    breakingExpiryField.style.display = breakingCheckbox.checked ? 'block' : 'none';
  });
</script>
