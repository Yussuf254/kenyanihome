<%- include('../partials/head') %>
<%-
  include('../partials/topbar', {
    heading: 'Application #' + application.id,
    crumb: application.jobTitle || 'Job Application'
  })
%>

<div class="panel-card">
  <div class="panel-card-head">
    <h3>Applicant Details</h3>
  </div>
  <table class="data-table">
    <tbody>
      <tr>
        <th style="width: 200px;">Full Name</th>
        <td><strong><%= application.name || 'N/A' %></strong></td>
      </tr>
      <tr>
        <th>Email</th>
        <td><%= application.email %></td>
      </tr>
      <tr>
        <th>Phone</th>
        <td><%= application.phone || 'Not provided' %></td>
      </tr>
      <tr>
        <th>Position</th>
        <td><%= job ? job.title : application.jobTitle || 'N/A' %></td>
      </tr>
      <tr>
        <th>Company</th>
        <td><%= application.company || (company && company.companyName) || 'N/A' %></td>
      </tr>
      <tr>
        <th>Status</th>
        <td>
          <form id="statusForm">
            <select id="statusSelect" onchange="updateStatus()" style="padding:6px 12px;border:1px solid var(--line);border-radius:var(--radius);font-family:'Montserrat',sans-serif;font-size:13px;">
              <option value="submitted" <%= application.status === 'submitted' ? 'selected' : '' %>>Submitted</option>
              <option value="under_review" <%= application.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
              <option value="shortlisted" <%= application.status === 'shortlisted' ? 'selected' : '' %>>Shortlisted</option>
              <option value="hired" <%= application.status === 'hired' ? 'selected' : '' %>>Hired</option>
              <option value="rejected" <%= application.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>
          </form>
        </td>
      </tr>
      <tr>
        <th>Applied</th>
        <td><%= formatDate(application.createdAt) %></td>
      </tr>
    </tbody>
  </table>
</div>

<% if (application.coverLetter) { %>
<div class="panel-card">
  <div class="panel-card-head">
    <h3>Cover Letter</h3>
  </div>
  <div class="panel-card-body" style="padding: 0;">
    <div style="padding: 16px 24px; white-space: pre-wrap; line-height: 1.7; color: var(--grey);">
      <%- application.coverLetter %>
    </div>
  </div>
</div>
<% } %>

<% if (application.additionalInfo) { %>
<div class="panel-card">
  <div class="panel-card-head">
    <h3>Additional Information</h3>
  </div>
  <div class="panel-card-body" style="padding: 0;">
    <div style="padding: 16px 24px; white-space: pre-wrap; line-height: 1.7; color: var(--grey);">
      <%- application.additionalInfo %>
    </div>
  </div>
</div>
<% } %>

<div class="panel-card">
  <div class="panel-card-head">
    <h3>Actions</h3>
  </div>
  <div class="panel-card-body">
    <a href="/admin/applications" class="btn btn-ghost btn-sm"><i class="bi bi-arrow-left"></i> Back to Applications</a>
    <% if (job) { %>
      <a href="/admin/jobs/<%= job.id %>" class="btn btn-ghost btn-sm"><i class="bi bi-briefcase"></i> View Job</a>
    <% } %>
  </div>
</div>

<style>
.pill { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
.pill-submitted { background: #e3f2fd; color: #1565c0; }
.pill-under_review { background: #fff3e0; color: #e65100; }
.pill-shortlisted { background: #e6f4ea; color: var(--kenya-green); }
.pill-rejected { background: #ffebee; color: #e51d3e; }
.pill-hired { background: #e8f5e9; color: #2e7d32; }
</style>

<script>
function updateStatus() {
  const select = document.getElementById('statusSelect');
  const status = select.value;
  fetch('/admin/applications/<%= application.id %>/status', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status })
  })
  .then(r => r.json())
  .then(() => location.reload())
  .catch(() => alert('Error updating status'));
}
</script>

<%- include('../partials/foot') %>