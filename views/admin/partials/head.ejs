<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#1a2223">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600;1,700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/public/css/admin.css" rel="stylesheet">
  <style>
    input, select, textarea { font-size: 16px; }
  </style>
</head>
<body class="admin-body">
<div class="app-shell">
  <aside class="sidebar">
      <a href="/admin" class="sidebar-brand">
         <% if (settings.logo) { %><img src="<%= settings.logo %>" alt="<%= settings.siteName %> logo" class="brand-logo"><% } else { %><span class="brand-text"><%= settings.siteName %></span><% } %>
      </a>
      <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
    <nav class="sidebar-nav">
      <div class="nav-label">Newsroom</div>
      <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>"><i class="bi bi-grid-1x2"></i> Dashboard</a>
      <% if (hasPermission(currentUser, 'posts:read')) { %>
        <a href="/admin/posts" class="<%= currentPath.startsWith('/admin/posts') ? 'active' : '' %>"><i class="bi bi-newspaper"></i> Posts</a>
      <% } %>
      <% if (hasPermission(currentUser, 'categories:read')) { %>
        <a href="/admin/categories" class="<%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>"><i class="bi bi-tags"></i> Categories</a>
      <% } %>
      <% if (hasPermission(currentUser, '*')) { %>
        <a href="/admin/header-items" class="<%= currentPath.startsWith('/admin/header-items') ? 'active' : '' %>"><i class="bi bi-layout-wtf"></i> Navigation</a>
      <% } %>
      <% if (hasPermission(currentUser, 'media:read')) { %>
        <a href="/admin/media" class="<%= currentPath.startsWith('/admin/media') ? 'active' : '' %>"><i class="bi bi-images"></i> Media Library</a>
      <% } %>
      <% if (hasPermission(currentUser, 'messages:read')) { %>
        <a href="/admin/messages" class="<%= currentPath.startsWith('/admin/messages') ? 'active' : '' %>"><i class="bi bi-envelope"></i> Messages</a>
      <% } %>
      <% if (hasPermission(currentUser, 'comments:approve')) { %>
        <a href="/admin/comments" class="<%= currentPath.startsWith('/admin/comments') ? 'active' : '' %>"><i class="bi bi-chat-dots"></i> Comments</a>
      <% } %>
      <% if (hasPermission(currentUser, 'subscribers:read')) { %>
        <a href="/admin/subscribers" class="<%= currentPath.startsWith('/admin/subscribers') ? 'active' : '' %>"><i class="bi bi-people"></i> Subscribers</a>
      <% } %>
      <% if (hasPermission(currentUser, 'posts:read')) { %>
        <a href="/admin/trash" class="<%= currentPath.startsWith('/admin/trash') ? 'active' : '' %>"><i class="bi bi-trash3"></i> Trash</a>
      <% } %>
      <div class="nav-label">Team</div>
<% if (hasPermission(currentUser, '*')) { %>
        <a href="/admin/users" class="<%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">
          <i class="bi bi-person"></i> Users
          <% if (pendingUserCount > 0) { %><span class="nav-badge"><%= pendingUserCount %></span><% } %>
        </a>
      <% } %>
      <div class="nav-label">Jobs</div>
      <% if (hasPermission(currentUser, '*')) { %>
         <a href="/admin/jobs" class="<%= currentPath.startsWith('/admin/jobs') ? 'active' : '' %>"><i class="bi bi-briefcase"></i> All Jobs</a>
         <a href="/admin/jobs/pending" class="<%= currentPath.startsWith('/admin/jobs/pending') ? 'active' : '' %>">
           <i class="bi bi-hourglass-split"></i> Pending Jobs
           <% if (typeof pendingJobsCount !== 'undefined' && pendingJobsCount > 0) { %><span class="nav-badge"><%= pendingJobsCount %></span><% } %>
         </a>
         <a href="/admin/jobs/published" class="<%= currentPath.startsWith('/admin/jobs/published') ? 'active' : '' %>"><i class="bi bi-check-circle"></i> Published Jobs</a>
         <a href="/admin/job-categories" class="<%= currentPath.startsWith('/admin/job-categories') ? 'active' : '' %>"><i class="bi bi-tags"></i> Job Categories</a>
         <a href="/admin/employers" class="<%= currentPath.startsWith('/admin/employers') ? 'active' : '' %>"><i class="bi bi-building"></i> Employers</a>
        <a href="/admin/applications" class="<%= currentPath.startsWith('/admin/applications') ? 'active' : '' %>"><i class="bi bi-file-earmark-person"></i> Applications</a>
      <% } %>
      <div class="nav-label">Insights</div>
      <% if (hasPermission(currentUser, '*')) { %>
        <a href="/admin/activity-logs" class="<%= currentPath.startsWith('/admin/activity-logs') ? 'active' : '' %>"><i class="bi bi-journal-text"></i> Activity Log</a>
      <% } %>
      <div class="nav-label">System</div>
      <% if (hasPermission(currentUser, '*')) { %>
        <a href="/admin/ads" class="<%= currentPath.startsWith('/admin/ads') ? 'active' : '' %>"><i class="bi bi-megaphone"></i> Advertising</a>
        <a href="/admin/ad-submissions" class="<%= currentPath.startsWith('/admin/ad-submissions') ? 'active' : '' %>"><i class="bi bi-shop"></i> Ad Submissions</a>
        <a href="/admin/ad-categories" class="<%= currentPath.startsWith('/admin/ad-categories') ? 'active' : '' %>"><i class="bi bi-grid"></i> Ad Categories</a>
        <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>"><i class="bi bi-gear"></i> Settings</a>
        <a href="/admin/logs" class="<%= currentPath.startsWith('/admin/logs') ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Error Log</a>
      <% } %>
      <a href="/" target="_blank"><i class="bi bi-box-arrow-up-right"></i> View Live Site</a>
    </nav>
    <div class="sidebar-foot">
      <div class="user">
        <div class="avatar"><%= (currentUser && currentUser.username || '?').charAt(0).toUpperCase() %></div>
        <span class="uname"><%= currentUser ? currentUser.username : '' %></span>
      </div>
      <div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap;">
      <form action="/admin/logout" method="post">
        <button type="submit">Sign Out</button>
      </form>
    </div>
  </aside>

  <div class="main-panel">
    <script>
      (function(){
        var toggle = document.getElementById('sidebar-toggle');
        var sidebar = document.querySelector('.sidebar');
        if (!toggle || !sidebar) return;
        toggle.addEventListener('click', function(e){
          e.stopPropagation();
          sidebar.classList.toggle('mobile-open');
          if (sidebar.classList.contains('mobile-open')) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        });
        document.addEventListener('click', function(e){
          if (sidebar.classList.contains('mobile-open') && !sidebar.contains(e.target)) {
            sidebar.classList.remove('mobile-open');
            document.body.style.overflow = '';
          }
        });
      })();
    </script>
