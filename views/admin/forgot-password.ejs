<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600;1,700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="/public/css/admin.css" rel="stylesheet">
</head>
<body class="admin-body">
  <div class="login-shell">
    <div class="login-card">
      <div class="login-brand">
        <% if (settings.logo) { %><img src="<%= settings.logo %>" alt="<%= settings.siteName %> logo" class="brand-logo"><% } else { %><span class="login-brand-word brand-text"><%= settings.siteName %></span><% } %>
      </div>
      <p class="login-title">Reset password</p>
      <p class="sub">Enter your username or email to begin</p>

      <% if (typeof error !== 'undefined' && error.length) { %><div class="flash flash-error" style="margin-bottom:20px;"><%= error[0] %></div><% } %>
      <% if (typeof success !== 'undefined' && success.length) { %><div class="flash flash-success" style="margin-bottom:20px;"><%= success[0] %></div><% } %>

      <form action="/admin/forgot-password" method="post">
        <div class="field">
          <label>Username or Email</label>
          <input type="text" name="usernameOrEmail" required autofocus>
        </div>
        <button type="submit" class="btn btn-signal btn-block"><i class="bi bi-arrow-right"></i>&nbsp; Continue</button>
      </form>
      <p class="hint"><a href="/admin/login">Back to sign in</a></p>
    </div>
  </div>
</body>
</html>
