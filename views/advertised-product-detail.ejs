<%- include('partials/head') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/public/css/advertise.css">

<style>
.product-detail-page{background:#fff;min-height:100vh}
.product-hero{background:#fff;padding:48px 0 32px;border-bottom:1px solid var(--line)}
.product-hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
.product-gallery{position:relative}
.product-gallery .main-img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:16px;border:1px solid var(--line);background:#f6f8f7}
.product-gallery .placeholder-icon{width:100%;aspect-ratio:16/10;border-radius:16px;border:1px solid var(--line);background:linear-gradient(135deg,#f6faf7,#fff);display:flex;align-items:center;justify-content:center;font-size:64px;color:rgba(20,30,25,.15)}
.product-info .breadcrumb{font-size:12px;color:var(--m);margin-bottom:16px}
.product-info .breadcrumb a{color:var(--green);text-decoration:none}
.product-info .breadcrumb a:hover{text-decoration:underline}
.product-info h1{font-size:32px;font-weight:800;line-height:1.15;letter-spacing:-0.02em;color:var(--ink);margin:0 0 8px}
.product-info .price{font-size:28px;font-weight:800;color:var(--ink);margin:0 0 16px}
.product-info .price .currency{font-size:16px;font-weight:600;color:var(--m);margin-right:4px}
.product-info .desc{font-size:15px;color:var(--m);line-height:1.7;margin:0 0 20px}
.product-meta{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px}
.product-meta .meta-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:100px;background:var(--bg-soft);border:1px solid var(--line);font-size:12px;color:var(--ink);font-weight:600}
.product-meta .meta-pill i{color:var(--green);font-size:11px}
.contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:24px}
.contact-card{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:12px;border:1px solid var(--line);background:#fff;text-decoration:none;color:inherit;transition:all .2s ease}
.contact-card:hover{border-color:var(--green);box-shadow:var(--shadow-hover);transform:translateY(-2px)}
.contact-card .c-icon{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.contact-card .c-icon.phone{background:#e8f3ec;color:var(--green)}
.contact-card .c-icon.whatsapp{background:#e8f5ee;color:#25D366}
.contact-card .c-icon.email{background:#eef2ff;color:#4f46e5}
.contact-card .c-icon.web{background:#fff7ed;color:#ea580c}
.contact-card .c-label{font-size:11px;color:var(--m);font-weight:500;margin-bottom:2px}
.contact-card .c-value{font-size:14px;font-weight:700;color:var(--ink)}
.seller-card{margin-top:28px;padding:22px;border-radius:14px;border:1px solid var(--line);background:var(--bg-soft)}
.seller-card h3{font-size:16px;font-weight:800;margin:0 0 6px;color:var(--ink)}
.seller-card p{font-size:13px;color:var(--m);margin:0;line-height:1.6}
.back-link{display:inline-flex;align-items:center;gap:6px;color:var(--green);font-weight:700;font-size:13px;text-decoration:none;margin-bottom:20px}
.back-link:hover{text-decoration:underline}

@media(max-width:860px){
  .product-hero-grid{grid-template-columns:1fr;gap:28px}
  .product-info h1{font-size:26px}
  .product-info .price{font-size:22px}
}
@media(max-width:600px){
  .product-hero{padding:28px 0 20px}
  .product-info h1{font-size:22px}
  .product-info .price{font-size:20px}
  .contact-grid{grid-template-columns:1fr}
}
</style>

<main class="product-detail-page">
  <section class="product-hero">
    <div class="container">
      <a href="/advertised-products" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to Products</a>
      <div class="product-hero-grid">
        <div class="product-gallery">
          <% if (product.images && product.images.length) { %>
            <img class="main-img" src="<%= product.images[0] %>" alt="<%= product.productName %>">
          <% } else if (product.logo) { %>
            <img class="main-img" src="<%= product.logo %>" alt="<%= product.productName %>">
          <% } else { %>
            <div class="placeholder-icon"><i class="fa-solid fa-box"></i></div>
          <% } %>
        </div>
        <div class="product-info">
          <div class="breadcrumb">
            <a href="/advertised-products">Products</a> / <%= product.productName %>
          </div>
          <h1><%= product.productName %></h1>
          <div class="price"><span class="currency"><%= product.currency || 'KSh' %></span><%= Number(product.price || 0).toLocaleString() %></div>
          <p class="desc"><%= product.fullDescription || product.shortDescription || '' %></p>
          <div class="product-meta">
            <span class="meta-pill"><i class="fa-solid fa-tag"></i> <%= product.category || 'General' %></span>
            <span class="meta-pill"><i class="fa-solid fa-store"></i> <%= product.businessName || 'Business' %></span>
            <span class="meta-pill"><i class="fa-solid fa-user"></i> <%= product.contactPerson || '' %></span>
            <span class="meta-pill"><i class="fa-solid fa-location-dot"></i> <%= product.location || 'Kenya' %></span>
            <% if (product.discount) { %>
              <span class="meta-pill" style="color:var(--r)"><i class="fa-solid fa-percent"></i> <%= product.discount %> OFF</span>
            <% } %>
          </div>

          <h2 style="font-size:18px;font-weight:800;margin:0 0 12px;color:var(--ink);">Contact Seller</h2>
          <div class="contact-grid">
            <% if (product.phone) { %>
              <a href="tel:<%= product.phone %>" class="contact-card">
                <div class="c-icon phone"><i class="fa-solid fa-phone"></i></div>
                <div><div class="c-label">Call</div><div class="c-value"><%= product.phone %></div></div>
              </a>
            <% } %>
            <% if (product.whatsapp || product.whatsappLink) { %>
              <% var waHref = (product.whatsappLink || 'https://wa.me/' + (product.whatsapp || '').replace(/[^0-9]/g, '')).trim(); %>
              <a href="<%= waHref %>" target="_blank" rel="noopener" class="contact-card">
                <div class="c-icon whatsapp"><i class="fa-brands fa-whatsapp"></i></div>
                <div><div class="c-label">WhatsApp</div><div class="c-value">Chat now</div></div>
              </a>
            <% } %>
            <% if (product.email) { %>
              <a href="mailto:<%= product.email %>" class="contact-card">
                <div class="c-icon email"><i class="fa-solid fa-envelope"></i></div>
                <div><div class="c-label">Email</div><div class="c-value"><%= product.email %></div></div>
              </a>
            <% } %>
            <% if (product.website) { %>
              <a href="<%= product.website %>" target="_blank" rel="noopener" class="contact-card">
                <div class="c-icon web"><i class="fa-solid fa-globe"></i></div>
                <div><div class="c-label">Website</div><div class="c-value">Visit website</div></div>
              </a>
            <% } %>
            <% if (product.productLink) { %>
              <a href="<%= product.productLink %>" target="_blank" rel="noopener" class="contact-card">
                <div class="c-icon web"><i class="fa-solid fa-arrow-up-right-from-square"></i></div>
                <div><div class="c-label">Product Link</div><div class="c-value">View product</div></div>
              </a>
            <% } %>
          </div>

          <div class="seller-card">
            <h3><%= product.businessName || 'Business' %></h3>
            <p><%= product.fullDescription || product.shortDescription || 'Contact us for more information about this product.' %></p>
            <div style="margin-top:16px;">
              <a href="/advertised-products/<%= product.id %>/receipt" class="btn-receipt btn-receipt-primary" style="display:inline-flex; align-items:center; gap:8px; padding:10px 20px; border-radius:100px; font-family:'Montserrat',sans-serif; font-size:12px; font-weight:700; letter-spacing:.04em; text-decoration:none; background:var(--knh-green); color:#fff; box-shadow:0 4px 14px rgba(26,107,60,.25); transition:all .2s ease;">
                <i class="fa-solid fa-receipt"></i> Generate Receipt
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/foot') %>
