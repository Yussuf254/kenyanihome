<%
function embedUrl(url) {
  if (!url) return '';
  var yt = url.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=|youtube\.com\/embed\/)([\w-]{6,})/);
  if (yt) return 'https://www.youtube.com/embed/' + yt[1];
  var vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return 'https://player.vimeo.com/video/' + vm[1];
  return url;
}
%>
<div class="single-post-wrap style-box">
  <span class="tag-base">Advertisement</span>
  <% if (ad.videoUrl) { %>
    <div class="thumb" style="border-radius:0; margin-bottom:0;">
      <iframe class="ad-video" src="<%= embedUrl(ad.videoUrl) %>" title="<%= ad.title %>" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy" style="width:100%; height:280px; border:0;"></iframe>
    </div>
  <% } else { %>
    <a class="thumb" href="/ads/<%= ad.id %>/click" target="_blank" rel="sponsored noopener" style="border-radius:0; margin-bottom:0;">
      <% if (ad.imageUrl) { %><img src="<%= ad.imageUrl %>" alt="<%= ad.title %>" loading="lazy"><% } %>
    </a>
  <% } %>
  <div class="details">
    <h3 class="title"><%= ad.title %></h3>
    <p><%= ad.description %></p>
    <a class="btn-base" href="/ads/<%= ad.id %>/click" target="_blank" rel="sponsored noopener">Learn more →</a>
  </div>
</div>
