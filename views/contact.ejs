<%- include('partials/head') %>
<link rel="stylesheet" href="/assets/css/contact.css">

<main class="main">
  <div class="page-title">
    <div class="wrap">
      <div>
        <span class="kicker">Reach Out</span>
        <h1>Contact Us</h1>
        <p class="page-subtitle">Have a story tip, feedback, or partnership idea? We'd love to hear from you.</p>
      </div>
    </div>
  </div>

  <section class="contact-section">
    <div class="contact-grid">
      <div class="contact-info">
        <div class="info-card">
          <i class="bi bi-telephone"></i>
          <div>
            <h3>Call Us</h3>
            <p><%= settings.phone || '+254 20 123 4567' %></p>
          </div>
        </div>
        <div class="info-card">
          <i class="bi bi-envelope"></i>
          <div>
            <h3>Email Us</h3>
            <p><%= settings.email || 'newsroom@kenyanihome.co.ke' %></p>
          </div>
        </div>
        <div class="info-card">
          <i class="bi bi-geo-alt"></i>
          <div>
            <h3>Visit Us</h3>
            <p><%= settings.address || 'Nairobi, Kenya' %></p>
          </div>
        </div>
        
        <div class="social-section">
          <h3>Follow Us</h3>
          <div class="social-links">
            <% if (settings.social && settings.social.twitter) { %><a href="<%= settings.social.twitter %>" title="Follow on X" class="social-link" aria-label="X / Twitter"><i class="bi bi-twitter"></i></a><% } %>
            <% if (settings.social && settings.social.facebook) { %><a href="<%= settings.social.facebook %>" title="Follow on Facebook" class="social-link" aria-label="Facebook"><i class="bi bi-facebook"></i></a><% } %>
            <% if (settings.social && settings.social.instagram) { %><a href="<%= settings.social.instagram %>" title="Follow on Instagram" class="social-link" aria-label="Instagram"><i class="bi bi-instagram"></i></a><% } %>
            <% if (settings.social && settings.social.linkedin) { %><a href="<%= settings.social.linkedin %>" title="Follow on LinkedIn" class="social-link" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a><% } %>
          </div>
        </div>

        <div class="map-wrap">
          <iframe class="map-frame" src="https://maps.google.com/maps?q=Nairobi,Kenya&t=&z=13&ie=UTF8&iwloc=&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <% if (success && success.length) { %><div class="alert alert-success"><%= success[0] %></div><% } %>
        <% if (error && error.length) { %><div class="alert alert-error"><%= error[0] %></div><% } %>
        
        <div style="margin-bottom:clamp(14px, 3vw, 20px); padding-bottom:clamp(10px, 2vw, 14px); border-bottom:1px solid #e4dfd7; position:relative;">
          <span style="font-size:clamp(10px, 2vw, 11px); font-weight:700; text-transform:uppercase; letter-spacing:0.18em; color:#0F6B34; display:block; margin-bottom:6px;">Reach Out</span>
          <h2 style="font-size:clamp(18px, 4vw, 22px); font-weight:800; margin:0; letter-spacing:-0.02em; color:#0C1210;">Send us a message</h2>
          <p style="font-size:clamp(12px, 2.5vw, 13px); color:#5f6b6c; margin:4px 0 0; line-height:1.5;">Have a story tip, feedback, or partnership idea? We'd love to hear from you.</p>
        </div>
        
        <form action="/contact" method="post" class="form-grid">
          <div class="field">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" required placeholder="Full name">
          </div>
          <div class="field">
            <label for="email">Your Email</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com">
          </div>
          <div class="field full">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" placeholder="What is this about?">
          </div>
          <div class="field full">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="8" placeholder="Tell us your story or feedback..." required></textarea>
          </div>
          <div class="full">
            <button type="submit" class="btn-primary">Send Message</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('partials/foot') %>
